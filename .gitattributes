#------------------------------------------------------------------------------
# REGULATORY SOURCE COPIES
#------------------------------------------------------------------------------
# Reserve this directory for byte-preserved source copies. Record each
# copy's SHA-256 in the register of docs/methodology/SOURCES.md.
# Never normalized, so the checked-out bytes keep the registered hash, and
# never checked for white space, because a copy keeps the line endings and
# trailing blanks of its issuer. A README in the directory, by convention, is
# ordinary documentation.
docs/methodology/sources/**             -text -whitespace
docs/methodology/sources/README.md      text eol=lf !whitespace


#------------------------------------------------------------------------------
# FILE-BASED TEST CASE VARIANTS
#------------------------------------------------------------------------------
# tests/fixtures/<case-id>/<variant>/ holds input files exactly as the workbook
# reads them: a case may test CRLF line endings, a missing final newline,
# trailing blanks or another encoding, so Git never converts these files and
# reports no white-space error in them. The case.json manifest, one level up,
# stays ordinary JSON. docs/methodology/TEST_CASES.md describes the format.
tests/fixtures/*/*/**                   -text -whitespace


#------------------------------------------------------------------------------
# ARCHIVE HYGIENE
#------------------------------------------------------------------------------
# These rules apply to git archive and archive producers that honor Git
# attributes. Repository plumbing is not part of a consumable source package:
# configuration, workflows, and the tests and tools that depend on them.
# Use GitHub's template creation or a clone for a full development checkout.
.gitattributes  export-ignore
.gitignore      export-ignore
.editorconfig   export-ignore
.github         export-ignore
tests           export-ignore
tools           export-ignore
pyproject.toml  export-ignore
AGENTS.md       export-ignore


#==============================================================================
# ENCODING POLICY
#------------------------------------------------------------------------------
# VBE exports use the Windows system code page, which differs between hosts.
# VBA source is ASCII only, identical in every code page, and
# any other character is built at run time with ChrW
# rather than embedded in exported source. These rules therefore stay
# disabled. Enabling one would need a new decision and a round-trip test:
#
#   *.bas  working-tree-encoding=windows-1252
#   *.cls  working-tree-encoding=windows-1252
#   *.frm  working-tree-encoding=windows-1252
#==============================================================================
