{
  "schema_version": 2,
  "description": "What an Excel run of the VBA harness must leave as evidence, read by tools/check_excel_run.py from the commit it checks, and by tools/devbuild/excel_run.py, tools/devbuild/export_manifest.py, tools/devbuild/lo_smoke.py and tools/render_docs.py. suite is the example suite, which certifies the harness itself in three modes; suites lists the project's own suites, each certified in its normal run by its own entry point, which saves its log, its certification log and, when the entry names a results file, the results of that run. The results files of all suites are measured together. tests/test_check_excel_run.py keeps it equal to the example suite, its certification entry point and the host policy of INSTALLATION.md.",
  "harness": "tests/modules/TEST_Harness.bas",
  "suite": {
    "name": "examples",
    "source": "tests/modules/TEST_Examples.bas",
    "certification_entry_point": "CertifyExamples",
    "expected_cases": 14,
    "expected_assertions": 34
  },
  "suites": [
    {"name": "core-err-parse", "source": "tests/modules/TEST_CoreErrParse.bas",
     "certification_entry_point": "CertifyCoreErrParse", "runner": "RunCoreErrParseTests",
     "expected_cases": 13, "expected_assertions": 632, "log": "core-err-parse.log",
     "certification_log": "core-err-parse-certification.log"},
    {"name": "core-dates", "source": "tests/modules/TEST_CoreDates.bas",
     "certification_entry_point": "CertifyCoreDates", "runner": "RunCoreDatesTests",
     "expected_cases": 13, "expected_assertions": 2111, "log": "core-dates.log",
     "certification_log": "core-dates-certification.log"},
    {"name": "core-array", "source": "tests/modules/TEST_CoreArray.bas",
     "certification_entry_point": "CertifyCoreArray", "runner": "RunCoreArrayTests",
     "expected_cases": 9, "expected_assertions": 132, "log": "core-array.log",
     "certification_log": "core-array-certification.log"},
    {"name": "ranges", "source": "tests/modules/TEST_Ranges.bas",
     "certification_entry_point": "CertifyRanges", "runner": "RunRangeTests",
     "expected_cases": 5, "expected_assertions": 62, "log": "ranges.log",
     "certification_log": "ranges-certification.log"},
    {"name": "dates", "source": "tests/modules/TEST_Dates.bas",
     "certification_entry_point": "CertifyDates", "runner": "RunDateTests",
     "expected_cases": 4, "expected_assertions": 85, "log": "dates.log",
     "certification_log": "dates-certification.log"},
    {"name": "date-cases", "source": "tests/modules/TEST_DateCases.bas",
     "certification_entry_point": "CertifyDateCases", "expected_cases": 65,
     "expected_assertions": 1561, "log": "date-cases.log",
     "certification_log": "date-cases-certification.log",
     "results": "date-cases-results.json"},
    {"name": "worksheet-cases", "source": "tests/modules/TEST_WorksheetCases.bas",
     "certification_entry_point": "CertifyWorksheetCases", "expected_cases": 3,
     "expected_assertions": 77, "log": "worksheet-cases.log",
     "certification_log": "worksheet-cases-certification.log",
     "results": "worksheet-cases-results.json"},
    {"name": "excel-host", "source": "tests/modules/TEST_Host.bas",
     "certification_entry_point": "CertifyHost", "runner": "RunHostTests",
     "expected_cases": 4, "expected_assertions": 41, "log": "excel-host.log",
     "certification_log": "excel-host-certification.log"},
    {"name": "excel-oracle", "source": "tests/modules/TEST_ExcelOracle.bas",
     "certification_entry_point": "CertifyExcelOracle", "expected_cases": 21,
     "expected_assertions": 437, "log": "excel-oracle.log",
     "certification_log": "excel-oracle-certification.log"},
    {"name": "ui", "source": "tests/modules/TEST_Ui.bas",
     "certification_entry_point": "CertifyUi", "runner": "RunUiTests",
     "expected_cases": 6, "expected_assertions": 35, "log": "ui.log",
     "certification_log": "ui-certification.log"}
  ],
  "modes": [
    {"mode": "NORMAL", "log": "examples.log", "must_pass": true},
    {"mode": "INJECTED_FAILURE", "log": "injected.log", "must_pass": false},
    {"mode": "SKIPPED_CASE", "log": "skipped.log", "must_pass": false}
  ],
  "evidence": {
    "certification_log": "certification.log",
    "exported": "exported",
    "host_record": "host.txt",
    "export_manifest": "export-manifest.json",
    "results": "results.json"
  },
  "host": {
    "references": [
      "Visual Basic For Applications",
      "Microsoft Excel 16.0 Object Library",
      "OLE Automation",
      "Microsoft Office 16.0 Object Library"
    ],
    "office": "64-bit"
  }
}
