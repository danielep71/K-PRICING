Attribute VB_Name = "TEST_WorksheetCases"

Option Explicit
Option Private Module

'
'------------------------------------------------------------------------------
' MODULE: TEST_WorksheetCases
'------------------------------------------------------------------------------
' PURPOSE
'   The worksheet-function cases of the date layer whose caller is a worksheet, replayed as
'   formulas in a scratch workbook of the case's date system: each result is compared, as
'   encoded text, with its expected file
'
' WHY THIS EXISTS
'   A worksheet caller reads its date system from its workbook and its arguments from
'   Ranges; only a formula in a workbook of that date system tests that path
'
' INPUTS
'   None at module level
'
' RETURNS
'   Nothing at module level
'
' BEHAVIOR
'   RunWorksheetCaseTests runs the suite: 3 cases of up to 30 test cases of one date
'   system, 77 assertions: one per test case, named after it, and scratch-closed per case.
'   CertifyWorksheetCases certifies its normal run and saves its log, its certification log
'   and its results file
'
' ERROR POLICY
'   As TEST_Harness.EndRun: a run that does not pass raises TEST_Harness.ERR_TEST_FAILED,
'   or the unexpected error that escaped the runner
'
' DEPENDENCIES
'   KPR_Dates, TEST_WorksheetSupport, TEST_DateCaseSupport, TEST_Harness; the Excel object model
'
' NOTES
'   - GENERATED by tools/gen_worksheet_case_suite.py from tests/fixtures/ and tests/expected/:
'     never edit it by hand; regenerate it with --write
'   - It opens and closes scratch workbooks and changes no cell of this workbook
'   - Option Private Module keeps the suite out of the workbook's external surface
'
' UPDATED
'   2026-11-26
'------------------------------------------------------------------------------

'------------------------------------------------------------------------------
' PRIVATE CONSTANTS
'------------------------------------------------------------------------------
    'A complete run starts every case and evaluates every assertion once
    Private Const SUITE_NAME            As String = "worksheet-cases"   'Suite name in the run log
    Private Const EXPECTED_CASES        As Long = 3                   'Cases a complete run starts
    Private Const EXPECTED_ASSERTIONS   As Long = 77                  'Assertions a complete run evaluates


'
'------------------------------------------------------------------------------
'
'                                 ENTRY POINTS
'
'------------------------------------------------------------------------------
'

Public Sub RunWorksheetCaseTests()

'
'------------------------------------------------------------------------------
'                                RUN THE SUITE
'------------------------------------------------------------------------------
' PURPOSE
'   Runs every case of the suite once, in its normal mode.
'
' WHY THIS EXISTS
'   The entry point to type in the Immediate window.
'
' INPUTS
'   None
'
' RETURNS
'   Nothing
'
' BEHAVIOR
'   Runs RunSuite.
'
' ERROR POLICY
'   As RunSuite
'
' DEPENDENCIES
'   RunSuite
'
' NOTES
'   None
'
' UPDATED
'   2026-11-26
'------------------------------------------------------------------------------

'------------------------------------------------------------------------------
' RUN
'------------------------------------------------------------------------------
    'Run the suite
        RunSuite

End Sub

Public Sub CertifyWorksheetCases( _
    ByVal Folder As String, _
    ByVal Fixtures As String)

'
'------------------------------------------------------------------------------
'                              CERTIFY THE SUITE
'------------------------------------------------------------------------------
' PURPOSE
'   Certifies the suite's normal run and saves its evidence in the folder.
'
' WHY THIS EXISTS
'   The certification entry point that .github/excel-evidence-policy.json names.
'
' INPUTS
'   Folder
'     The evidence folder.
'
'   Fixtures
'     The tests/fixtures/ folder, which this generated suite does not read.
'
' RETURNS
'   Nothing
'
' BEHAVIOR
'   Runs the suite, saves its log, certifies the run, saves its results and then the
'   certification log.
'
' ERROR POLICY
'   TEST_Harness.EndCertification raises when the certification did not pass.
'
' DEPENDENCIES
'   RunSuite, TEST_Harness
'
' NOTES
'   None
'
' UPDATED
'   2026-11-26
'------------------------------------------------------------------------------

'------------------------------------------------------------------------------
' DECLARE
'------------------------------------------------------------------------------
    Dim RunErrorNumber          As Long     'Error that ended the run; 0 for none
    Dim RunErrorDescription     As String   'Its description

'------------------------------------------------------------------------------
' CERTIFY
'------------------------------------------------------------------------------
    'Refuse state left by an earlier run and start the certification
        TEST_Harness.BeginCertification SUITE_NAME
    'Run the suite and capture the error that ended it
        On Error Resume Next
        RunSuite
        RunErrorNumber = Err.Number
        RunErrorDescription = Err.Description
    'Restore normal error handling
        On Error GoTo 0
    'Save the log, certify the run and save its results
        TEST_Harness.SaveLog Folder & "\worksheet-cases.log"
        TEST_Harness.CertifyRun "NORMAL", True, RunErrorNumber, RunErrorDescription
        TEST_Harness.SaveResults Folder & "\worksheet-cases-results.json"
    'Save the certification log, raising when the certification did not pass
        TEST_Harness.EndCertification Folder & "\worksheet-cases-certification.log"

End Sub

'
'------------------------------------------------------------------------------
'
'                                    RUNNER
'
'------------------------------------------------------------------------------
'

Private Sub RunSuite()

'
'------------------------------------------------------------------------------
'                                RUN EVERY CASE
'------------------------------------------------------------------------------
' PURPOSE
'   Runs every case once, in a fixed order, between BeginRun and EndRun.
'
' WHY THIS EXISTS
'   The certification reads the cases this runner calls.
'
' INPUTS
'   None
'
' RETURNS
'   Nothing
'
' BEHAVIOR
'   Starts the run, calls each case, then reports the run.
'
' ERROR POLICY
'   As TEST_Harness.EndRun
'
' DEPENDENCIES
'   TEST_Harness
'
' NOTES
'   None
'
' UPDATED
'   2026-11-26
'------------------------------------------------------------------------------

'------------------------------------------------------------------------------
' DECLARE
'------------------------------------------------------------------------------
    Dim ErrNumber       As Long     'Runner error number; 0 for none
    Dim ErrSource       As String   'Runner error source
    Dim ErrDescription  As String   'Runner error description

'------------------------------------------------------------------------------
' RUN
'------------------------------------------------------------------------------
    'Start the run; a refused start propagates directly
        TEST_Harness.BeginRun SUITE_NAME, "NORMAL", EXPECTED_CASES, EXPECTED_ASSERTIONS
    'Send an error that escapes a case to the runner handler
        On Error GoTo RunFailed
    'Run every case in a fixed order
        CaseWs1900Part01
        CaseWs1904Part01
        CaseWs1904Part02

Finish:
    'Restore normal error handling
        On Error GoTo 0
    'Report the run, raising its failure or the escaped error
        TEST_Harness.EndRun ErrNumber, ErrSource, ErrDescription

'------------------------------------------------------------------------------
' EXIT PROCEDURE
'------------------------------------------------------------------------------
    'Exit before the error handler
        Exit Sub

'------------------------------------------------------------------------------
' ERROR HANDLER
'------------------------------------------------------------------------------
RunFailed:
    'Keep the escaped error for EndRun
        ErrNumber = Err.Number
        ErrSource = Err.Source
        ErrDescription = Err.Description
        Resume Finish

End Sub

