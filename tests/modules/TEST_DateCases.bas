Private Sub CaseDayOfWeek01()

'
'------------------------------------------------------------------------------
'                              CASES OF DAYOFWEEK
'------------------------------------------------------------------------------
' PURPOSE
'   Replays 30 worksheet-function cases of KPR_Dates_DayOfWeek, from control-weekbase-array-1d-single
'   to shape-control-1d-pair, called from VBA.
'
' WHY THIS EXISTS
'   Each assertion compares one case's encoded result with its expected file.
'
' INPUTS
'   None
'
' RETURNS
'   Nothing
'
' BEHAVIOR
'   Calls the function with each case's arguments, encodes the result, asserts it
'   under the case's id and records it for the exact accuracy contracts.
'
' ERROR POLICY
'   An unexpected error is recorded against the case by
'   TEST_Harness.RecordCaseError and does not stop the run
'
' DEPENDENCIES
'   KPR_Dates_DayOfWeek, TEST_DateCaseSupport, TEST_Harness
'
' NOTES
'   Generated by tools/gen_date_case_suite.py from tests/fixtures/
'
' UPDATED
'   2026-11-26
'------------------------------------------------------------------------------

'------------------------------------------------------------------------------
' DECLARE
'------------------------------------------------------------------------------
    Dim Actual          As String       'The encoded result of the case

'------------------------------------------------------------------------------
' INITIALIZE
'------------------------------------------------------------------------------
    'Record an unexpected error against the case
        On Error GoTo CaseFailed
    'Start the case
        TEST_Harness.BeginCase "day-of-week-01"

'------------------------------------------------------------------------------
' RUN CASES
'------------------------------------------------------------------------------
    'Opt_WeekBaseMonday accepts omitted, Empty or native Boolean only.
        Actual = TEST_DateCaseSupport.Encode(KPR_Dates_DayOfWeek(DateSerial(2024, 2, 11), TEST_DateCaseSupport.A1(True)))
        TEST_Harness.AssertEqualText "control-weekbase-array-1d-single", "lng:7", Actual
        TEST_Harness.RecordTextResult "control-weekbase-array-1d-single", vbNullString, "weekday_number", vbNullString, vbNullString, Actual
    'Opt_WeekBaseMonday accepts omitted, Empty or native Boolean only.
        Actual = TEST_DateCaseSupport.Encode(KPR_Dates_DayOfWeek(DateSerial(2024, 2, 11), TEST_DateCaseSupport.A2(1, 1, False)))
        TEST_Harness.AssertEqualText "control-weekbase-array-1x1", "lng:1", Actual
        TEST_Harness.RecordTextResult "control-weekbase-array-1x1", vbNullString, "weekday_number", vbNullString, vbNullString, Actual
    'Opt_WeekBaseMonday accepts omitted, Empty or native Boolean only.
        Actual = TEST_DateCaseSupport.Encode(KPR_Dates_DayOfWeek(DateSerial(2024, 2, 11), TEST_DateCaseSupport.A2(1, 2, True, False)))
        TEST_Harness.AssertEqualText "control-weekbase-array-1x2", "err:#VALUE!", Actual
        TEST_Harness.RecordTextResult "control-weekbase-array-1x2", vbNullString, "weekday_number", vbNullString, vbNullString, Actual
    'Opt_WeekBaseMonday accepts omitted, Empty or native Boolean only.
        Actual = TEST_DateCaseSupport.Encode(KPR_Dates_DayOfWeek(DateSerial(2024, 2, 11), DateSerial(2024, 1, 1)))
        TEST_Harness.AssertEqualText "control-weekbase-date", "err:#VALUE!", Actual
        TEST_Harness.RecordTextResult "control-weekbase-date", vbNullString, "weekday_number", vbNullString, vbNullString, Actual
    'Opt_WeekBaseMonday accepts omitted, Empty or native Boolean only.
        Actual = TEST_DateCaseSupport.Encode(KPR_Dates_DayOfWeek(DateSerial(2024, 2, 11), Empty))
        TEST_Harness.AssertEqualText "control-weekbase-empty", "lng:7", Actual
        TEST_Harness.RecordTextResult "control-weekbase-empty", vbNullString, "weekday_number", vbNullString, vbNullString, Actual
    'Opt_WeekBaseMonday accepts omitted, Empty or native Boolean only.
        Actual = TEST_DateCaseSupport.Encode(KPR_Dates_DayOfWeek(DateSerial(2024, 2, 11), CVErr(2007)))
        TEST_Harness.AssertEqualText "control-weekbase-error", "err:#DIV/0!", Actual
        TEST_Harness.RecordTextResult "control-weekbase-error", vbNullString, "weekday_number", vbNullString, vbNullString, Actual
    'Opt_WeekBaseMonday accepts omitted, Empty or native Boolean only.
        Actual = TEST_DateCaseSupport.Encode(KPR_Dates_DayOfWeek(DateSerial(2024, 2, 11), False))
        TEST_Harness.AssertEqualText "control-weekbase-false", "lng:1", Actual
        TEST_Harness.RecordTextResult "control-weekbase-false", vbNullString, "weekday_number", vbNullString, vbNullString, Actual
    'Opt_WeekBaseMonday accepts omitted, Empty or native Boolean only.
        Actual = TEST_DateCaseSupport.Encode(KPR_Dates_DayOfWeek(DateSerial(2024, 2, 11), Null))
        TEST_Harness.AssertEqualText "control-weekbase-null", "err:#VALUE!", Actual
        TEST_Harness.RecordTextResult "control-weekbase-null", vbNullString, "weekday_number", vbNullString, vbNullString, Actual
    'Opt_WeekBaseMonday accepts omitted, Empty or native Boolean only.
        Actual = TEST_DateCaseSupport.Encode(KPR_Dates_DayOfWeek(DateSerial(2024, 2, 11), 0#))
        TEST_Harness.AssertEqualText "control-weekbase-num-0", "err:#VALUE!", Actual
        TEST_Harness.RecordTextResult "control-weekbase-num-0", vbNullString, "weekday_number", vbNullString, vbNullString, Actual
    'Opt_WeekBaseMonday accepts omitted, Empty or native Boolean only.
        Actual = TEST_DateCaseSupport.Encode(KPR_Dates_DayOfWeek(DateSerial(2024, 2, 11), 1#))
        TEST_Harness.AssertEqualText "control-weekbase-num-1", "err:#VALUE!", Actual
        TEST_Harness.RecordTextResult "control-weekbase-num-1", vbNullString, "weekday_number", vbNullString, vbNullString, Actual
    'Opt_WeekBaseMonday accepts omitted, Empty or native Boolean only.
        Actual = TEST_DateCaseSupport.Encode(KPR_Dates_DayOfWeek(DateSerial(2024, 2, 11)))
        TEST_Harness.AssertEqualText "control-weekbase-omitted", "lng:7", Actual
        TEST_Harness.RecordTextResult "control-weekbase-omitted", vbNullString, "weekday_number", vbNullString, vbNullString, Actual
    'Opt_WeekBaseMonday accepts omitted, Empty or native Boolean only.
        Actual = TEST_DateCaseSupport.Encode(KPR_Dates_DayOfWeek(DateSerial(2024, 2, 11), "TRUE"))
        TEST_Harness.AssertEqualText "control-weekbase-text-true", "err:#VALUE!", Actual
        TEST_Harness.RecordTextResult "control-weekbase-text-true", vbNullString, "weekday_number", vbNullString, vbNullString, Actual
    'Opt_WeekBaseMonday accepts omitted, Empty or native Boolean only.
        Actual = TEST_DateCaseSupport.Encode(KPR_Dates_DayOfWeek(DateSerial(2024, 2, 11), True))
        TEST_Harness.AssertEqualText "control-weekbase-true", "lng:7", Actual
        TEST_Harness.RecordTextResult "control-weekbase-true", vbNullString, "weekday_number", vbNullString, vbNullString, Actual
    'DateIn: a 1x1 array is the scalar call.
        Actual = TEST_DateCaseSupport.Encode(KPR_Dates_DayOfWeek(TEST_DateCaseSupport.A2(1, 1, DateSerial(2024, 2, 10))))
        TEST_Harness.AssertEqualText "matrix-dayofweek-datein-array-1x1", "lng:6", Actual
        TEST_Harness.RecordTextResult "matrix-dayofweek-datein-array-1x1", vbNullString, "weekday_number", vbNullString, vbNullString, Actual
    'DateIn: a column keeps its orientation.
        Actual = TEST_DateCaseSupport.Encode(KPR_Dates_DayOfWeek(TEST_DateCaseSupport.A2(3, 1, DateSerial(2024, 2, 10), DateSerial(1900, 3, 1), DateSerial(2023, 11, 30))))
        TEST_Harness.AssertEqualText "matrix-dayofweek-datein-array-column", "arr2:3x1[lng:6;lng:4;lng:4]", Actual
        TEST_Harness.RecordTextResult "matrix-dayofweek-datein-array-column", vbNullString, "weekday_number", vbNullString, vbNullString, Actual
    'DateIn: a rectangle keeps its shape and per-element outcomes.
        Actual = TEST_DateCaseSupport.Encode(KPR_Dates_DayOfWeek(TEST_DateCaseSupport.A2(2, 2, DateSerial(2024, 2, 10), DateSerial(9999, 12, 31), "2024-02-30", DateSerial(2023, 11, 30))))
        TEST_Harness.AssertEqualText "matrix-dayofweek-datein-array-rectangle", "arr2:2x2[lng:6;lng:5;err:#VALUE!;lng:4]", Actual
        TEST_Harness.RecordTextResult "matrix-dayofweek-datein-array-rectangle", vbNullString, "weekday_number", vbNullString, vbNullString, Actual
    'DateIn: a row keeps valid, invalid and error elements at their positions.
        Actual = TEST_DateCaseSupport.Encode(KPR_Dates_DayOfWeek(TEST_DateCaseSupport.A2(1, 3, DateSerial(2024, 2, 10), DateSerial(1900, 2, 28), CVErr(2007))))
        TEST_Harness.AssertEqualText "matrix-dayofweek-datein-array-row", "arr2:1x3[lng:6;err:#NUM!;err:#DIV/0!]", Actual
        TEST_Harness.RecordTextResult "matrix-dayofweek-datein-array-row", vbNullString, "weekday_number", vbNullString, vbNullString, Actual
    'DateIn: the highest supported value.
        Actual = TEST_DateCaseSupport.Encode(KPR_Dates_DayOfWeek(DateSerial(9999, 12, 31)))
        TEST_Harness.AssertEqualText "matrix-dayofweek-datein-edge-high", "lng:5", Actual
        TEST_Harness.RecordTextResult "matrix-dayofweek-datein-edge-high", vbNullString, "weekday_number", vbNullString, vbNullString, Actual
    'DateIn: the lowest supported value.
        Actual = TEST_DateCaseSupport.Encode(KPR_Dates_DayOfWeek(DateSerial(1900, 3, 1)))
        TEST_Harness.AssertEqualText "matrix-dayofweek-datein-edge-low", "lng:4", Actual
        TEST_Harness.RecordTextResult "matrix-dayofweek-datein-edge-low", vbNullString, "weekday_number", vbNullString, vbNullString, Actual
    'DateIn: an invalid-domain value.
        Actual = TEST_DateCaseSupport.Encode(KPR_Dates_DayOfWeek(DateSerial(1900, 2, 28)))
        TEST_Harness.AssertEqualText "matrix-dayofweek-datein-invalid-a", "err:#NUM!", Actual
        TEST_Harness.RecordTextResult "matrix-dayofweek-datein-invalid-a", vbNullString, "weekday_number", vbNullString, vbNullString, Actual
    'DateIn: a second invalid-domain value.
        Actual = TEST_DateCaseSupport.Encode(KPR_Dates_DayOfWeek("2024-02-30"))
        TEST_Harness.AssertEqualText "matrix-dayofweek-datein-invalid-b", "err:#VALUE!", Actual
        TEST_Harness.RecordTextResult "matrix-dayofweek-datein-invalid-b", vbNullString, "weekday_number", vbNullString, vbNullString, Actual
    'DateIn: an incoming error propagates.
        Actual = TEST_DateCaseSupport.Encode(KPR_Dates_DayOfWeek(CVErr(2042)))
        TEST_Harness.AssertEqualText "matrix-dayofweek-datein-propagated", "err:#N/A", Actual
        TEST_Harness.RecordTextResult "matrix-dayofweek-datein-propagated", vbNullString, "weekday_number", vbNullString, vbNullString, Actual
    'A valid scalar call.
        Actual = TEST_DateCaseSupport.Encode(KPR_Dates_DayOfWeek(DateSerial(2024, 2, 10)))
        TEST_Harness.AssertEqualText "matrix-dayofweek-ok", "lng:6", Actual
        TEST_Harness.RecordTextResult "matrix-dayofweek-ok", vbNullString, "weekday_number", vbNullString, vbNullString, Actual
    'The call: CAPACITY_EXCEEDED, a case the completeness policy requires.
        Actual = TEST_DateCaseSupport.Encode(KPR_Dates_DayOfWeek(TEST_DateCaseSupport.F2(1, 100001, DateSerial(2024, 2, 10))))
        TEST_Harness.AssertEqualText "policy-dayofweek-call-capacity-exceeded", "err:#NUM!", Actual
        TEST_Harness.RecordTextResult "policy-dayofweek-call-capacity-exceeded", vbNullString, "weekday_number", vbNullString, vbNullString, Actual
    'The call: SHAPE_UNSUPPORTED, a case the completeness policy requires.
        Actual = TEST_DateCaseSupport.Encode(KPR_Dates_DayOfWeek(TEST_DateCaseSupport.A1()))
        TEST_Harness.AssertEqualText "policy-dayofweek-call-shape-unsupported", "err:#VALUE!", Actual
        TEST_Harness.RecordTextResult "policy-dayofweek-call-shape-unsupported", vbNullString, "weekday_number", vbNullString, vbNullString, Actual
    'DateIn: DATE_TEXT_LOCALE, a case the completeness policy requires.
        Actual = TEST_DateCaseSupport.Encode(KPR_Dates_DayOfWeek("10/02/2024"))
        TEST_Harness.AssertEqualText "policy-dayofweek-datein-date-text-locale", "err:#VALUE!", Actual
        TEST_Harness.RecordTextResult "policy-dayofweek-datein-date-text-locale", vbNullString, "weekday_number", vbNullString, vbNullString, Actual
    'DateIn: DATE_TEXT_NUMERIC, a case the completeness policy requires.
        Actual = TEST_DateCaseSupport.Encode(KPR_Dates_DayOfWeek("45332"))
        TEST_Harness.AssertEqualText "policy-dayofweek-datein-date-text-numeric", "err:#VALUE!", Actual
        TEST_Harness.RecordTextResult "policy-dayofweek-datein-date-text-numeric", vbNullString, "weekday_number", vbNullString, vbNullString, Actual
    'DateIn: DATE_TYPE_REJECTED, a case the completeness policy requires.
        Actual = TEST_DateCaseSupport.Encode(KPR_Dates_DayOfWeek(True))
        TEST_Harness.AssertEqualText "policy-dayofweek-datein-date-type-rejected", "err:#VALUE!", Actual
        TEST_Harness.RecordTextResult "policy-dayofweek-datein-date-type-rejected", vbNullString, "weekday_number", vbNullString, vbNullString, Actual
    'DateIn: INPUT_BLANK_REQUIRED, a case the completeness policy requires.
        Actual = TEST_DateCaseSupport.Encode(KPR_Dates_DayOfWeek(Empty))
        TEST_Harness.AssertEqualText "policy-dayofweek-datein-input-blank-required", "err:#VALUE!", Actual
        TEST_Harness.RecordTextResult "policy-dayofweek-datein-input-blank-required", vbNullString, "weekday_number", vbNullString, vbNullString, Actual
    'A two-element 1-D control is not scalar.
        Actual = TEST_DateCaseSupport.Encode(KPR_Dates_DayOfWeek(TEST_DateCaseSupport.A2(1, 2, DateSerial(2024, 2, 10), DateSerial(2024, 2, 10)), TEST_DateCaseSupport.A1(False, True)))
        TEST_Harness.AssertEqualText "shape-control-1d-pair", "err:#VALUE!", Actual
        TEST_Harness.RecordTextResult "shape-control-1d-pair", vbNullString, "weekday_number", vbNullString, vbNullString, Actual

'------------------------------------------------------------------------------
' EXIT PROCEDURE
'------------------------------------------------------------------------------
    'Exit before the error handler
        Exit Sub

'------------------------------------------------------------------------------
' ERROR HANDLER
'------------------------------------------------------------------------------
CaseFailed:
    'Record the unexpected error against the case
        TEST_Harness.RecordCaseError

End Sub

Private Sub CaseDayOfWeek02()

'
'------------------------------------------------------------------------------
'                              CASES OF DAYOFWEEK
'------------------------------------------------------------------------------
' PURPOSE
'   Replays 30 worksheet-function cases of KPR_Dates_DayOfWeek, from surface-dayofweek-bad-datein
'   to weekday-sunday-base-2000-03-31, called from VBA.
'
' WHY THIS EXISTS
'   Each assertion compares one case's encoded result with its expected file.
'
' INPUTS
'   None
'
' RETURNS
'   Nothing
'
' BEHAVIOR
'   Calls the function with each case's arguments, encodes the result, asserts it
'   under the case's id and records it for the exact accuracy contracts.
'
' ERROR POLICY
'   An unexpected error is recorded against the case by
'   TEST_Harness.RecordCaseError and does not stop the run
'
' DEPENDENCIES
'   KPR_Dates_DayOfWeek, TEST_DateCaseSupport, TEST_Harness
'
' NOTES
'   Generated by tools/gen_date_case_suite.py from tests/fixtures/
'
' UPDATED
