Attribute VB_Name = "TEST_DateCases"

Option Explicit
Option Private Module

'
'------------------------------------------------------------------------------
' MODULE: TEST_DateCases
'------------------------------------------------------------------------------
' PURPOSE
'   The worksheet-function cases of the date layer whose caller is VBA, replayed on the
'   KPR_Dates facade: each result is compared, as encoded text, with its expected file
'
' WHY THIS EXISTS
'   The cases of tests/fixtures/ and the exact accuracy contracts ACC-02 to ACC-23 are
'   measured on the workbook only through a suite that calls the functions in Excel
'
' INPUTS
'   None at module level
'
' RETURNS
'   Nothing at module level
'
' BEHAVIOR
'   RunDateCaseTests runs the suite: 61 cases of up to 30 test cases of one function,
'   1432 assertions, one per test case, named after it. CertifyDateCases certifies its
'   normal run and saves its log, its certification log and its results file
'
' ERROR POLICY
'   As TEST_Harness.EndRun: a run that does not pass raises TEST_Harness.ERR_TEST_FAILED,
'   or the unexpected error that escaped the runner
'
' DEPENDENCIES
'   KPR_Dates, TEST_DateCaseSupport, TEST_Harness
'
' NOTES
'   - GENERATED by tools/gen_date_case_suite.py from tests/fixtures/ and tests/expected/:
'     never edit it by hand; regenerate it with --write
'   - A case of a worksheet caller (ws1900, ws1904) needs a worksheet and is not here
'   - Option Private Module keeps the suite out of the workbook's external surface
'
' UPDATED
'   2026-11-26
'------------------------------------------------------------------------------

'------------------------------------------------------------------------------
' PRIVATE CONSTANTS
'------------------------------------------------------------------------------
    'A complete run starts every case and evaluates every assertion once
    Private Const SUITE_NAME            As String = "date-cases"        'Suite name in the run log
    Private Const EXPECTED_CASES        As Long = 61                  'Cases a complete run starts
    Private Const EXPECTED_ASSERTIONS   As Long = 1432                'Assertions a complete run evaluates


'
'------------------------------------------------------------------------------
'
'                                 ENTRY POINTS
'
'------------------------------------------------------------------------------
'

Public Sub RunDateCaseTests()

'
'------------------------------------------------------------------------------
'                                RUN THE SUITE
'------------------------------------------------------------------------------
' PURPOSE
'   Runs every case of the suite once, in its normal mode.
'
' WHY THIS EXISTS
'   The entry point to type in the Immediate window.
'
' INPUTS
'   None
'
' RETURNS
'   Nothing
'
' BEHAVIOR
'   Runs RunSuite.
'
' ERROR POLICY
'   As RunSuite
'
' DEPENDENCIES
'   RunSuite
'
' NOTES
'   None
'
' UPDATED
'   2026-11-26
'------------------------------------------------------------------------------

'------------------------------------------------------------------------------
' RUN
'------------------------------------------------------------------------------
    'Run the suite
        RunSuite

End Sub

Public Sub CertifyDateCases( _
    ByVal Folder As String, _
    ByVal Fixtures As String)

'
'------------------------------------------------------------------------------
'                              CERTIFY THE SUITE
'------------------------------------------------------------------------------
' PURPOSE
'   Certifies the suite's normal run and saves its evidence in the folder.
'
' WHY THIS EXISTS
'   The certification entry point that .github/excel-evidence-policy.json names.
'
' INPUTS
'   Folder
'     The evidence folder.
'
'   Fixtures
'     The tests/fixtures/ folder, which this generated suite does not read.
'
' RETURNS
'   Nothing
'
' BEHAVIOR
'   Runs the suite, saves its log, certifies the run, saves its results and then the
'   certification log.
'
' ERROR POLICY
'   TEST_Harness.EndCertification raises when the certification did not pass.
'
' DEPENDENCIES
'   RunSuite, TEST_Harness
'
' NOTES
'   None
'
' UPDATED
'   2026-11-26
'------------------------------------------------------------------------------

'------------------------------------------------------------------------------
' DECLARE
'------------------------------------------------------------------------------
    Dim RunErrorNumber          As Long     'Error that ended the run; 0 for none
    Dim RunErrorDescription     As String   'Its description

'------------------------------------------------------------------------------
' CERTIFY
'------------------------------------------------------------------------------
    'Refuse state left by an earlier run and start the certification
        TEST_Harness.BeginCertification SUITE_NAME
    'Run the suite and capture the error that ended it
        On Error Resume Next
        RunSuite
        RunErrorNumber = Err.Number
        RunErrorDescription = Err.Description
    'Restore normal error handling
        On Error GoTo 0
    'Save the log, certify the run and save its results
        TEST_Harness.SaveLog Folder & "\date-cases.log"
        TEST_Harness.CertifyRun "NORMAL", True, RunErrorNumber, RunErrorDescription
        TEST_Harness.SaveResults Folder & "\date-cases-results.json"
    'Save the certification log, raising when the certification did not pass
        TEST_Harness.EndCertification Folder & "\date-cases-certification.log"

End Sub

'
'------------------------------------------------------------------------------
'
'                                    RUNNER
'
'------------------------------------------------------------------------------
'

Private Sub RunSuite()

'
'------------------------------------------------------------------------------
'                                RUN EVERY CASE
'------------------------------------------------------------------------------
' PURPOSE
'   Runs every case once, in a fixed order, between BeginRun and EndRun.
'
' WHY THIS EXISTS
'   The certification reads the cases this runner calls.
'
' INPUTS
'   None
'
' RETURNS
'   Nothing
'
' BEHAVIOR
'   Starts the run, calls each case, then reports the run.
'
' ERROR POLICY
'   As TEST_Harness.EndRun
'
' DEPENDENCIES
'   TEST_Harness
'
' NOTES
'   None
'
' UPDATED
'   2026-11-26
'------------------------------------------------------------------------------

'------------------------------------------------------------------------------
' DECLARE
'------------------------------------------------------------------------------
    Dim ErrNumber       As Long     'Runner error number; 0 for none
    Dim ErrSource       As String   'Runner error source
    Dim ErrDescription  As String   'Runner error description

'------------------------------------------------------------------------------
' RUN
'------------------------------------------------------------------------------
    'Start the run; a refused start propagates directly
        TEST_Harness.BeginRun SUITE_NAME, "NORMAL", EXPECTED_CASES, EXPECTED_ASSERTIONS
    'Send an error that escapes a case to the runner handler
        On Error GoTo RunFailed
    'Run every case in a fixed order
        CaseDayOfWeek01
        CaseDayOfWeek02
        CaseDayOfWeek03
        CaseDaysInMonth01
        CaseDaysInMonth02
        CaseDaysInYear01
        CaseDaysInYear02
        CaseBeginOfMonth01
        CaseBeginOfMonth02
        CaseEndOfMonth01
        CaseEndOfMonth02
        CaseEndOfMonth03
        CaseEndOfMonth04
        CaseBeginOfQuarter01
        CaseBeginOfQuarter02
        CaseEndOfQuarter01
        CaseEndOfQuarter02
        CaseBeginOfYear01
        CaseBeginOfYear02
        CaseEndOfYear01
        CaseEndOfYear02
        CaseIsMonthEnd01
        CaseIsMonthEnd02
        CaseIsQuarterEnd01
        CaseIsQuarterEnd02
        CaseIsYearEnd01
        CaseIsYearEnd02
        CaseIsLeapYear01
        CaseIsLeapYear02
        CaseAddDays01
        CaseAddDays02
        CaseAddDays03
        CaseAddWeeks01
        CaseAddWeeks02
        CaseAddMonths01
        CaseAddMonths02
        CaseAddMonths03
        CaseAddYears01
        CaseAddYears02
        CaseNthWeekdayOfMonth01
        CaseNthWeekdayOfMonth02
        CaseNthWeekdayOfMonth03
        CaseLastWeekdayOfMonth01
        CaseLastWeekdayOfMonth02
        CasePillarFromDates01
        CasePillarFromDates02
        CasePillarFromDates03
        CasePillarFromDates04
        CasePillarFromDates05
        CasePillarFromDates06
        CasePillarFromDates07
        CasePillarFromDates08
        CasePillarFromDates09
        CasePillarFromDates10
        CasePillarFromDates11
        CaseDateFromPillar01
        CaseDateFromPillar02
        CaseDateFromPillar03
        CaseDateFromPillar04
        CaseDateFromPillar05
        CaseHostDateSystem01

Finish:
    'Restore normal error handling
        On Error GoTo 0
    'Report the run, raising its failure or the escaped error
        TEST_Harness.EndRun ErrNumber, ErrSource, ErrDescription

'------------------------------------------------------------------------------
' EXIT PROCEDURE
'------------------------------------------------------------------------------
    'Exit before the error handler
        Exit Sub

'------------------------------------------------------------------------------
' ERROR HANDLER
'------------------------------------------------------------------------------
RunFailed:
    'Keep the escaped error for EndRun
        ErrNumber = Err.Number
        ErrSource = Err.Source
        ErrDescription = Err.Description
        Resume Finish

End Sub

