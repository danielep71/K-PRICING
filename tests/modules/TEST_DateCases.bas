        On Error GoTo CaseFailed
    'Start the case
        TEST_Harness.BeginCase "day-of-week-02"

'------------------------------------------------------------------------------
' RUN CASES
'------------------------------------------------------------------------------
    'An invalid DateIn is an element-level #VALUE!.
        Actual = TEST_DateCaseSupport.Encode(KPR_Dates_DayOfWeek("2024/02/10"))
