Attribute VB_Name = "KPR_REGRESSION_TESTS"
'==============================================================================
' MODULE: KPR_REGRESSION_TESTS
'------------------------------------------------------------------------------
' PURPOSE
'   Deterministic regression suites for the KPR date layer, launched from one
'   dispatcher, plus separate macro-only runners for host, Range-shape,
'   dynamic-array and worksheet-fixture behavior, and the durable runner that
'   drives all of them and writes structured evidence.
'
' SUITE REGISTRY
'   KPR_Tests_RunAll dispatches to the suites below. Passing a suite name runs
'   only that suite; omitting the argument runs all of them in order.
'
'       date-type     accepted and rejected scalar types at a date position
'       date-text     ISO acceptance, locale and numeric text, impossible dates
'       date-window   the supported window and the values adjacent to it
'       integer       fractions, Boolean, text, and range before integrality
'       control       optional Boolean controls and their defaults
'       boundary      window mapping, propagation and composition, via the facade
'       mapper        ErrForCondition mappings and its refusals
'       host          the date-system guard and diagnostic from direct VBA,
'                     and #N/A provenance
'       pillar        rounding modes, the derived 3W / 1M boundary, the week
'                     cap, grammar conditions and format/parse consistency
'       surface       the completed 22-name surface, YearIn conversions,
'                     the singular pillar name and the window floor boundaries
'       shape         array-engine services on in-memory inputs:
'                     classification, 1xN, broadcasting, capacity, elements
'       parity        every value argument of every value-taking function,
'                     vectorized element-for-element against the scalar call
'
'   One further pure suite is dispatched by name but is not part of "all",
'   which stays the migrated twelve-suite baseline:
'
'       fixtures      every direct-VBA case generated by tools/gen_fixtures.py
'                     into KPR_Test_Fixtures_Generated, with strict result
'                     types, native error codes and array shape and content
'
'   A suite is added by writing one Private Sub and one Case line, and one
'   TestRegistry entry when the durable runner should select it. The
'   dispatcher remains the only shared routing machinery.
'
' DURABLE REGISTRY
'   KPR_Test_RunAll runs TestRegistry in order: the twelve suites above, then
'   fixtures, then the macro-only runners as worksheet-host, worksheet-shape,
'   worksheet-array and worksheet-fixtures. KPR_Test_RunSuite runs one of
'   them. tools/check_test_evidence.py reads the registry from this source.
'
' SCOPE
'   - Condition classification is asserted directly against KPR_Core_Parse, so a
'     test names the exact contract condition rather than only the error value.
'   - Window, propagation, wrapper and composition behaviour is asserted through
'     KPR_DATES_DAYS, because those decisions belong to the public boundary.
'   - Expected results for the fixtures suites are generated independently
'     of this implementation (tools/gen_fixtures.py, issue #38). The durable
'     runner and its evidence record are issue #39; the evidence format is
'     docs/kpr-test-evidence.schema.json, documented in
'     docs/KPR_TEST_EVIDENCE.md.
'
' USAGE
'   Two durable entry points, callable through Application.Run and the
'   Immediate window, return TRUE only when every selected case passed,
'   caller state was restored and the evidence file was written:
'
'       KPR_Test_RunAll sha, folder           every registered suite
'       KPR_Test_RunSuite name, sha, folder   one registered suite
'
'   They are test infrastructure, not supported production API. Direct calls
'   into KPR_Dates_* use the documented direct-VBA 1900 contract. Both save
'   and restore calculation, events, screen updating, alerts, the status bar,
'   the active workbook and sheet and the selection, and refuse a worksheet
'   caller.
'
'   Three interactive entry points reach the pure dispatcher:
'
'       KPR_Tests_Run                 every pure suite; appears in the Alt+F8
'                                     macro list and prints its report to the
'                                     Immediate window
'       KPR_Tests_RunSuite "integer"  one pure suite, printed the same way
'       KPR_Tests_RunAll()            returns a two-column array for a worksheet
'                                     or for programmatic use
'
'   Four stateful entry points are deliberately NOT reachable from the
'   pure dispatcher above; the durable runner orchestrates them:
'
'       KPR_Tests_RunHost             creates a scratch workbook, exercises the
'                                     real worksheet-Range caller path under
'                                     1900 and 1904, and closes the workbook.
'                                     Macro-only: it adds and closes a
'                                     workbook, which cannot legally happen
'                                     inside a worksheet function call.
'       KPR_Tests_RunShape            creates a scratch workbook and exercises
'                                     the array engine on real Ranges: row,
'                                     column, rectangle, multi-area, blanks and
'                                     errors, UsedRange independence, and
'                                     caller-state restoration. Macro-only for
'                                     the same reason.
'       KPR_Tests_RunArray            enters a multi-cell formula through the
'                                     late-bound dynamic-array API and checks
'                                     the spill, then repeats it in a 1904
'                                     workbook and checks the single call-level
'                                     #N/A. Reports SUPPORTED or NOT_AVAILABLE
'                                     for the spill API; unavailable is a
'                                     failure, not a pass.
'       KPR_Tests_RunFixtureHost      replays the generated fixture cases whose
'                                     context is a 1900 or 1904 worksheet
'                                     caller as Range formulas in a scratch
'                                     workbook.
'
'   KPR_Tests_RunAll returns an array, so it cannot be inspected with ? in the
'   Immediate window and cannot appear in the macro list. Use KPR_Tests_Run
'   there. On a worksheet, enter =KPR_Tests_RunAll() and let it spill.
'
'   Reports use Debug.Print only and never MsgBox. The pure runners touch no
'   workbook state. Each stateful runner creates and closes its own scratch
'   workbook without selecting or activating worksheets and without consulting
'   ActiveWorkbook. Only the durable runner reads the active workbook, sheet
'   and selection, and only to restore them.
'
' CONDITION IDENTIFIERS
'   Assertions carry the semantic identifier string from the contract registry,
'   never the internal enum number. The enum numbering is an implementation
'   detail and must not reach fixtures or evidence.
'
' ALLOWED DEPENDENCIES
'   KPR_Core_Parse, KPR_Core_Dates, KPR_Core_Array and KPR_Core_Err, called
'   directly to assert exact classification, KPR_DATES_DAYS for boundary
'   behaviour, and KPR_Test_Fixtures_Generated for generated expectations.
'   No other module is reachable from here. The stateful runners also
'   use Excel.Workbooks.Add and the scratch workbooks they create, always
'   through exact object references and never through ActiveWorkbook.
'
' UPDATED
'   2026-09-25
'
' AUTHOR
'   Daniele Penza
'==============================================================================

'------------------------------------------------------------------------------
' MODULE SETTINGS
'------------------------------------------------------------------------------
    Option Explicit         'Force explicit variable declarations

    'This module deliberately does NOT declare Option Private Module. A harness
    'that cannot be launched is not a harness: Option Private Module hides its
    'members from the Alt+F8 macro list, from Application.Run and from the
    'worksheet, leaving the Immediate window as the only entry. Tests are
    'developer-facing, they declare no KPR_Dates_* name, and the static gate
    'constrains visibility only for core and facade modules.

'------------------------------------------------------------------------------
' MODULE STATE
'------------------------------------------------------------------------------
    'Accumulated failures and assertion count for the current run
        Private mFailures   As Collection
        Private mChecks     As Long

    'TRUE while the durable runner drives the macro-only runners: their
    'Immediate-window reports and migration trace lines are suppressed and a
    'failed cleanup is recorded as a failure instead of only being printed
        Private mQuietTrace As Boolean

'------------------------------------------------------------------------------
' MODULE CONSTANTS
'------------------------------------------------------------------------------
    'File the durable runner writes into its output folder
        Private Const EVIDENCE_FILE As String = "kpr-test-evidence.json"

'------------------------------------------------------------------------------
' MODULE TYPES
'------------------------------------------------------------------------------
    'Caller state captured before a durable run and restored after it
        Private Type CallerState
            Calculation         As XlCalculation
            EnableEvents        As Boolean
            ScreenUpdating      As Boolean
            DisplayAlerts       As Boolean
            StatusBar           As Variant
            Book                As Object
            SheetObject         As Object
            SelectionObject     As Object
            BookName            As String
            SheetName           As String
            SelectionType       As String
            SelectionAddress    As String
            SelectionName       As String
        End Type

    'Everything one durable run records in its evidence file
        Private Type RunRecord
            SuiteSelection      As String
            EntryPoint          As String
            SourceSha           As String
            CallerType          As String
            StartedAt           As Date
            FinishedAt          As Date
            TotalMs             As Long
            SuiteCount          As Long
            SuiteNames()        As String
            SuiteStatus()       As String
            SuiteChecks()       As Long
            SuiteFails()        As Long
            SuiteMs()           As Long
            Failures            As Collection
            TotalChecks         As Long
            StateOk             As Boolean
            StateDetail         As String
            RunError            As String
            Passed              As Boolean
        End Type


'
'------------------------------------------------------------------------------
'
'                              MACRO ENTRY POINTS
'
'------------------------------------------------------------------------------
'

Public Sub KPR_Tests_Run()
'
'==============================================================================
'                                 KPR_Tests_Run
'------------------------------------------------------------------------------
' PURPOSE
'   Runs every suite and writes the report to the Immediate window.
'
'   This is the entry point to use from the Alt+F8 macro list or by typing
'   KPR_Tests_Run in the Immediate window. It takes no arguments and returns
'   nothing, which is what makes it visible there; KPR_Tests_RunAll returns an
'   array and therefore cannot appear in the macro list.
'
' OUTPUT
'   Debug.Print only. No MsgBox, no worksheet write, no selection, no
'   ActiveWorkbook access.
'
' UPDATED
'   2026-08-31
'==============================================================================
'

'------------------------------------------------------------------------------
' RUN
'------------------------------------------------------------------------------
    'Every suite in registry order
        ReportRun "all"

End Sub

Public Sub KPR_Tests_RunSuite( _
    ByVal SuiteName As String)
'
'==============================================================================
'                              KPR_Tests_RunSuite
'------------------------------------------------------------------------------
' PURPOSE
'   Runs one named suite and writes the report to the Immediate window.
'
' USAGE
'   KPR_Tests_RunSuite "date-text"
'
' NOTES
'   - Takes an argument, so it does not appear in the Alt+F8 list. Call it from
'     the Immediate window.
'
' UPDATED
'   2026-08-31
'==============================================================================
'

'------------------------------------------------------------------------------
' RUN
'------------------------------------------------------------------------------
    'One suite from the registry
        ReportRun SuiteName

End Sub

Public Sub KPR_Tests_RunEvidence()
'
'==============================================================================
'                            KPR_Tests_RunEvidence
'------------------------------------------------------------------------------
' PURPOSE
'   Runs the complete pure regression suite through KPR_Tests_RunAll and emits
'   the stable machine-readable lines required by K-PRICING retained Excel
'   evidence. This is a destination evidence adapter; it does not change test
'   cases, expectations, production code or the native KPR_Tests_Run report.
'
' OUTPUT
'   One CASE= line for each suite in the same order used by RunSuite("all"),
'   followed by CASES, ASSERTIONS, FAILURES and one RESULT line. Failure detail
'   from the native returned array is retained between the counts and RESULT.
'
' UPDATED
'   2026-09-24
'==============================================================================
'

'------------------------------------------------------------------------------
' DECLARE
'------------------------------------------------------------------------------
    Const EVIDENCE_CASES As Long = 12
    Dim Results          As Variant      'Native KPR_Tests_RunAll result
    Dim Checks           As Long         'Observed assertion count
    Dim Failures         As Long         'Observed failure count
    Dim I                As Long         'Failure row cursor
    Dim Verdict          As String       'PASS or FAIL for retained evidence
    Dim SummaryText      As String       'Native summary cell being parsed
    Dim Separator        As Long         'Colon between label and numeric count

'------------------------------------------------------------------------------
' RUN
'------------------------------------------------------------------------------
    On Error GoTo Evidence_Error
    Results = KPR_Tests_RunAll("all")
    If Not IsArray(Results) Then GoTo Evidence_Refused

'------------------------------------------------------------------------------
' READ NATIVE SUMMARY
'------------------------------------------------------------------------------
    SummaryText = CStr(Results(1, 1))
    Separator = InStr(1, SummaryText, ":", vbBinaryCompare)
    If Separator = 0 Then GoTo Evidence_Refused
    Checks = CLng(Trim$(Mid$(SummaryText, Separator + 1)))

    SummaryText = CStr(Results(1, 2))
    Separator = InStr(1, SummaryText, ":", vbBinaryCompare)
    If Separator = 0 Then GoTo Evidence_Refused
    Failures = CLng(Trim$(Mid$(SummaryText, Separator + 1)))

'------------------------------------------------------------------------------
' EMIT SUITE ORDER
'------------------------------------------------------------------------------
    Debug.Print "CASE=date-type"
    Debug.Print "CASE=date-text"
    Debug.Print "CASE=date-window"
    Debug.Print "CASE=integer"
    Debug.Print "CASE=control"
    Debug.Print "CASE=boundary"
    Debug.Print "CASE=mapper"
    Debug.Print "CASE=host"
    Debug.Print "CASE=pillar"
    Debug.Print "CASE=surface"
    Debug.Print "CASE=shape"
    Debug.Print "CASE=parity"

'------------------------------------------------------------------------------
' EMIT COUNTS AND FAILURE DETAIL
'------------------------------------------------------------------------------
    Debug.Print "CASES=" & CStr(EVIDENCE_CASES)
    Debug.Print "ASSERTIONS=" & CStr(Checks)
    Debug.Print "FAILURES=" & CStr(Failures)

    For I = 2 To UBound(Results, 1)
        Debug.Print "  FAIL  " & CStr(Results(I, 1)) & " : " & CStr(Results(I, 2))
    Next I

    If Failures = 0 Then
        Verdict = "PASS"
    Else
        Verdict = "FAIL"
    End If

    Debug.Print "RESULT=" & Verdict & _
                "; completeness=COMPLETE; cases=" & CStr(EVIDENCE_CASES) & _
                "; assertions=" & CStr(Checks) & _
                "; failures=" & CStr(Failures) & _
                "; cleanup=PASS"
    Exit Sub

'------------------------------------------------------------------------------
' REFUSED / UNEXPECTED RETURN
'------------------------------------------------------------------------------
Evidence_Refused:
    Debug.Print "CASES=" & CStr(EVIDENCE_CASES)
    Debug.Print "ASSERTIONS=0"
    Debug.Print "FAILURES=1"
    Debug.Print "  FAIL  evidence/runner : " & CStr(Results)
    Debug.Print "RESULT=FAIL; completeness=INCOMPLETE; cases=" & _
                CStr(EVIDENCE_CASES) & _
                "; assertions=0; failures=1; cleanup=PASS"
    Exit Sub

'------------------------------------------------------------------------------
' DEFENSIVE ERROR REPORT
'------------------------------------------------------------------------------
Evidence_Error:
    Debug.Print "CASES=" & CStr(EVIDENCE_CASES)
    Debug.Print "ASSERTIONS=0"
    Debug.Print "FAILURES=1"
    Debug.Print "  FAIL  evidence/runner : unexpected runtime error " & _
                CStr(Err.Number) & ": " & Err.Description
    Debug.Print "RESULT=FAIL; completeness=INCOMPLETE; cases=" & _
                CStr(EVIDENCE_CASES) & _
                "; assertions=0; failures=1; cleanup=PASS"

End Sub

Public Sub KPR_Tests_RunMigrationEvidence()
'
'==============================================================================
'                       KPR_Tests_RunMigrationEvidence
'------------------------------------------------------------------------------
' PURPOSE
'   Emits deterministic source-versus-destination observations for migration
'   issue #17. The same candidate regression module is used as instrumentation
'   against frozen-source production modules and destination production modules.
'
' OUTPUT
'   OBS<TAB>id<TAB>payload
'   CLEANUP<TAB>runner<TAB>PASS|failure-detail
'
' NOTES
'   - This adapter does not call the pure-suite dispatcher. Frozen-source and
'     destination pure runs are retained separately because test counts and
'     known correctness fixes differ legitimately between the two baselines.
'   - No observation is part of the supported 22-function production API.
'
' UPDATED
'   2026-09-24
'==============================================================================
'
    On Error GoTo Migration_Error

    Debug.Print "MIGRATION_OBSERVATIONS_BEGIN"
    MigrationPrintValue "direct/days-in-month", KPR_Dates_DaysInMonth("2024-02-15")
    MigrationPrintValue "direct/add-days", KPR_Dates_AddDays("2026-03-15", 5)
    MigrationPrintValue "direct/strict-date-error", KPR_Dates_BeginOfMonth("03/15/2026")

    KPR_Tests_RunHost
    KPR_Tests_RunShape
    KPR_Tests_RunArray

    Debug.Print "MIGRATION_OBSERVATIONS_END"
    Exit Sub

Migration_Error:
    MigrationPrintText "migration/runner", _
                       "ERROR:" & CStr(Err.Number) & ":" & MigrationEscape(Err.Description)
    Err.Clear
    Debug.Print "MIGRATION_OBSERVATIONS_END"

End Sub

Private Sub ReportRun( _
    ByVal SuiteName As String)
'
'==============================================================================
'                                   ReportRun
'------------------------------------------------------------------------------
' PURPOSE
'   Runs a suite through the same function the worksheet uses, then prints the
'   result so a run is never silent.
'
' NOTES
'   - Deliberately shares KPR_Tests_RunAll rather than duplicating dispatch, so
'     the macro path and the worksheet path cannot report different outcomes.
'
' UPDATED
'   2026-08-31
'==============================================================================
'

'------------------------------------------------------------------------------
' DECLARE
'------------------------------------------------------------------------------
    Dim Results     As Variant      'Result of the run
    Dim I           As Long         'Row cursor

'------------------------------------------------------------------------------
' RUN
'------------------------------------------------------------------------------
    'Reuse the single implementation
        Results = KPR_Tests_RunAll(SuiteName)

'------------------------------------------------------------------------------
' REPORT
'------------------------------------------------------------------------------
    'A refused suite name comes back as a plain string
        If Not IsArray(Results) Then
            Debug.Print "KPR regression: " & CStr(Results)
            Exit Sub
        End If

    'Summary first, so a passing run is one visible line
        Debug.Print "KPR regression [" & SuiteName & "]  " & _
                    CStr(Results(1, 1)) & "  " & CStr(Results(1, 2))

    'Then one line per failure, if any
        For I = 2 To UBound(Results, 1)
            Debug.Print "  FAIL  " & CStr(Results(I, 1)) & " : " & CStr(Results(I, 2))
        Next I

End Sub

'
'------------------------------------------------------------------------------
'
'                                  ENTRY POINT
'
'------------------------------------------------------------------------------
'

Public Function KPR_Tests_RunAll( _
    Optional ByVal Opt_Suite As Variant) _
    As Variant
'
'==============================================================================
'                                KPR_Tests_RunAll
'------------------------------------------------------------------------------
' PURPOSE
'   Runs one suite or every suite and returns the result.
'
' INPUTS
'   Opt_Suite
'     Omitted or Empty runs every suite. Otherwise a suite name from the
'     registry in the module header, compared case-insensitively.
'
' RETURNS
'   Variant
'     2-D array. Row 1 is the assertion count and the failure count. Each
'     further row is a failing case label and its detail.
'
'     An unknown suite name returns a single explanatory string rather than an
'     empty pass, so a typo cannot look like success.
'
' ERROR POLICY
'   - Never raises to the caller and never shows UI.
'   - An unexpected runtime error is reported as a failure, because reaching a
'     defensive handler is itself a defect.
'
' NOTES
'   - The suite list is duplicated in neither direction: RunSuite owns dispatch
'     and the header documents it. Adding a suite touches one Case line.
'
' UPDATED
'   2026-08-31
'==============================================================================
'

'------------------------------------------------------------------------------
' DECLARE
'------------------------------------------------------------------------------
    Dim SuiteName   As String       'Requested suite, normalized
    Dim Results     As Variant      'Returned summary and failure detail
    Dim I           As Long         'Row cursor
    Dim OuterFails  As Collection   'State of any run this call interrupted
    Dim OuterChecks As Long         'Its assertion count

'------------------------------------------------------------------------------
' INITIALIZE
'------------------------------------------------------------------------------
    'Contain any unexpected error as a reported failure
        On Error GoTo Err_Handler

    'This function is worksheet-callable, so a cell holding =KPR_Tests_RunAll()
    'can be recalculated in the MIDDLE of another run: the stateful host
    'runner calls Application.Calculate, and that reaches such a cell. Save
    'whatever run is in progress and restore it on exit, so an interrupted
    'runner reports its own results rather than this call's.
        Set OuterFails = mFailures
        OuterChecks = mChecks

    'Fresh state for this run
        Set mFailures = New Collection
        mChecks = 0

    'An omitted or blank suite means every suite
        If IsMissing(Opt_Suite) Then
            SuiteName = "all"
        ElseIf IsEmpty(Opt_Suite) Then
            SuiteName = "all"
        Else
            SuiteName = LCase$(Trim$(CStr(Opt_Suite)))
        End If

'------------------------------------------------------------------------------
' DISPATCH
'------------------------------------------------------------------------------
    'Run the requested suite, or refuse a name that is not in the registry
        If Not RunSuite(SuiteName) Then
            KPR_Tests_RunAll = "unknown suite: " & SuiteName
            Set mFailures = OuterFails
            mChecks = OuterChecks
            Exit Function
        End If

'------------------------------------------------------------------------------
' ASSIGN RESULT
'------------------------------------------------------------------------------
    'Summary row plus one row per failure
        ReDim Results(1 To mFailures.Count + 1, 1 To 2)
        Results(1, 1) = "checks: " & CStr(mChecks)
        Results(1, 2) = "failures: " & CStr(mFailures.Count)

    'Detail rows
        For I = 1 To mFailures.Count
            Results(I + 1, 1) = mFailures(I)(0)
            Results(I + 1, 2) = mFailures(I)(1)
        Next I

    'Return the array, then hand back any interrupted run's state
        KPR_Tests_RunAll = Results
        Set mFailures = OuterFails
        mChecks = OuterChecks
        Exit Function

'------------------------------------------------------------------------------
' ERR_HANDLER
'------------------------------------------------------------------------------
Err_Handler:
    'A raise reaching here is a defect, so report it rather than swallowing it
        KPR_Tests_RunAll = "unexpected runtime error " & CStr(Err.Number) & ": " & Err.Description
        Set mFailures = OuterFails
        mChecks = OuterChecks

End Function

Private Function RunSuite( _
    ByVal SuiteName As String) _
    As Boolean
'
'==============================================================================
'                                   RunSuite
'------------------------------------------------------------------------------
' PURPOSE
'   Maps a suite name to its cases. The single place that knows what suites
'   exist.
'
' RETURNS
'   Boolean
'     TRUE  => the name was recognized and its cases ran
'     FALSE => the name is not in the registry; nothing ran
'
' UPDATED
'   2026-08-31
'==============================================================================
'

'------------------------------------------------------------------------------
' INITIALIZE
'------------------------------------------------------------------------------
    'Unrecognized until proven otherwise, so a typo cannot pass silently
        RunSuite = True

'------------------------------------------------------------------------------
' DISPATCH
'------------------------------------------------------------------------------
    Select Case SuiteName

        Case "all"
            'Every suite, in registry order
                Run_DateTypeCases
                Run_DateTextCases
                Run_DateWindowCases
                Run_IntegerCases
                Run_ControlCases
                Run_BoundaryCases
                Run_MapperCases
                Run_HostCases
                Run_PillarCases
                Run_SurfaceCases
                Run_ShapeCases
                Run_ParityCases

        Case "date-type":       Run_DateTypeCases
        Case "date-text":       Run_DateTextCases
        Case "date-window":     Run_DateWindowCases
        Case "integer":         Run_IntegerCases
        Case "control":         Run_ControlCases
        Case "boundary":        Run_BoundaryCases
        Case "mapper":          Run_MapperCases
        Case "host":            Run_HostCases
        Case "pillar":          Run_PillarCases
        Case "surface":         Run_SurfaceCases
        Case "shape":           Run_ShapeCases
        Case "parity":          Run_ParityCases

        'Registered by name only: not part of "all", which stays the migrated
        'twelve-suite baseline used by KPR_Tests_RunEvidence
        Case "fixtures":        Run_FixtureCases

        Case Else
            'Not in the registry
                RunSuite = False

    End Select

End Function

'
'------------------------------------------------------------------------------
'
'                     DURABLE RUNNER AND STRUCTURED EVIDENCE
'
'------------------------------------------------------------------------------
'

Public Function KPR_Test_RunAll( _
    ByVal SourceSha As String, _
    ByVal OutputFolder As String) _
    As Boolean
'
'==============================================================================
'                                KPR_Test_RunAll
'------------------------------------------------------------------------------
' PURPOSE
'   Runs every suite in the durable registry and writes structured evidence
'   bound to the supplied exact source SHA.
'
' INPUTS
'   SourceSha
'     Full 40-character lowercase Git commit SHA of the imported source.
'   OutputFolder
'     Folder outside tracked source that receives kpr-test-evidence.json. It
'     and any missing parents are created; an existing evidence file is
'     overwritten.
'
' RETURNS
'   Boolean
'     TRUE  => every selected case passed, caller state was restored and the
'              evidence file was written
'     FALSE => anything else, including a refused input
'
' NOTES
'   - Callable through Application.Run and the Immediate window. Test
'     infrastructure, not supported production API.
'   - Refuses a worksheet caller: the worksheet suites add and close a scratch
'     workbook and the runner writes a file, neither of which is legal inside
'     a worksheet function call.
'   - Reports use Debug.Print only and never MsgBox.
'
' UPDATED
'   2026-09-25
'==============================================================================
'

'------------------------------------------------------------------------------
' RUN
'------------------------------------------------------------------------------
    'Every registered suite, in registry order
        KPR_Test_RunAll = RunRegistry("all", "KPR_Test_RunAll", SourceSha, OutputFolder)

End Function

Public Function KPR_Test_RunSuite( _
    ByVal SuiteName As String, _
    ByVal SourceSha As String, _
    ByVal OutputFolder As String) _
    As Boolean
'
'==============================================================================
'                               KPR_Test_RunSuite
'------------------------------------------------------------------------------
' PURPOSE
'   Runs one named suite from the durable registry and writes the same
'   structured evidence as KPR_Test_RunAll for that selection.
'
' INPUTS
'   SuiteName
'     A name from TestRegistry, compared case-insensitively. An unknown name
'     runs nothing, writes nothing and returns FALSE.
'   SourceSha, OutputFolder
'     As for KPR_Test_RunAll.
'
' RETURNS
'   Boolean
'     TRUE only when every case of the suite passed, caller state was
'     restored and the evidence file was written.
'
' UPDATED
'   2026-09-25
'==============================================================================
'

'------------------------------------------------------------------------------
' RUN
'------------------------------------------------------------------------------
    'One registered suite
        KPR_Test_RunSuite = RunRegistry(LCase$(Trim$(SuiteName)), "KPR_Test_RunSuite", SourceSha, OutputFolder)

End Function

Private Function TestRegistry() As Variant
'
' The ordered durable-runner registry. tools/check_test_evidence.py reads this
' list from source, so it is the single definition of what "all" selects.
'

'------------------------------------------------------------------------------
' REGISTRY
'------------------------------------------------------------------------------
    TestRegistry = Array( _
        "date-type", "date-text", "date-window", "integer", "control", _
        "boundary", "mapper", "host", "pillar", "surface", "shape", _
        "parity", "fixtures", "worksheet-host", "worksheet-shape", _
        "worksheet-array", "worksheet-fixtures")

End Function

Private Function SuiteKind( _
    ByVal SuiteName As String) _
    As String
'
' Classifies a registered suite for the evidence record.
'

'------------------------------------------------------------------------------
' CLASSIFY
'------------------------------------------------------------------------------
    Select Case SuiteName
        Case "fixtures"
            SuiteKind = "fixture"
        Case "worksheet-host", "worksheet-shape", "worksheet-array", "worksheet-fixtures"
            SuiteKind = "worksheet"
        Case Else
            SuiteKind = "pure"
    End Select

End Function

Private Sub ExecuteSuite( _
    ByVal SuiteName As String)
'
' Runs one registered suite into the current module state. Pure suites reuse
' RunSuite; worksheet suites reuse the macro-only runners, which reset the
' module state themselves.
'

'------------------------------------------------------------------------------
' DISPATCH
'------------------------------------------------------------------------------
    Select Case SuiteName
        Case "worksheet-host":      KPR_Tests_RunHost
        Case "worksheet-shape":     KPR_Tests_RunShape
        Case "worksheet-array":     KPR_Tests_RunArray
        Case "worksheet-fixtures":  KPR_Tests_RunFixtureHost
        Case Else
            If Not RunSuite(SuiteName) Then
                Record "runner/" & SuiteName, "suite is registered but has no dispatch"
            End If
    End Select

End Sub

Private Function RunRegistry( _
    ByVal SuiteSelection As String, _
    ByVal EntryPoint As String, _
    ByVal SourceSha As String, _
    ByVal OutputFolder As String) _
    As Boolean
'
'==============================================================================
'                                  RunRegistry
'------------------------------------------------------------------------------
' PURPOSE
'   The single implementation behind KPR_Test_RunAll and KPR_Test_RunSuite:
'   validates the inputs, runs the selected suites with caller state saved,
'   restores that state, and writes the evidence record.
'
' STATE
'   Calculation, events, screen updating, alerts, the status bar, the active
'   workbook and sheet and the selection are captured first and restored on
'   every exit path, then verified; a restoration failure fails the run.
'   Any run this call interrupts keeps its own accumulated results.
'
' UPDATED
'   2026-09-25
'==============================================================================
'

'------------------------------------------------------------------------------
' DECLARE
'------------------------------------------------------------------------------
    Dim Registry        As Variant      'Ordered suite names
    Dim Rec             As RunRecord    'Everything the evidence file records
    Dim State           As CallerState  'Caller state captured before the run
    Dim StateCaptured   As Boolean      'TRUE once State holds the caller's state
    Dim EvidencePath    As String       'Full path of the evidence file
    Dim Why             As String       'Reason an input was refused
    Dim OuterFails      As Collection   'State of any run this call interrupted
    Dim OuterChecks     As Long         'Its assertion count
    Dim OuterQuiet      As Boolean      'Its trace setting
    Dim StartTimer      As Double       'Timer at run start
    Dim SuiteTimer      As Double       'Timer at suite start
    Dim Current         As Long         'Index of the suite being run
    Dim Harvested       As Boolean      'TRUE once the current suite was recorded
    Dim I               As Long         'Suite cursor
    Dim F               As Long         'Failure cursor
    Dim Entry           As Variant      'One recorded failure: suite, case, detail

'------------------------------------------------------------------------------
' VALIDATE INPUTS
'------------------------------------------------------------------------------
    RunRegistry = False

    'A worksheet formula cannot add workbooks or write files
        If CallerTypeName() = "Range" Then
            Debug.Print "KPR test runner: refused; it cannot run from a worksheet formula"
            Exit Function
        End If

    'Evidence binds to one exact commit
        If Not IsFullSha(SourceSha) Then
            Debug.Print "KPR test runner: refused; SourceSha must be a full 40-character lowercase commit SHA"
            Exit Function
        End If

    'Resolve the selection against the registry
        Registry = TestRegistry()
        If SuiteSelection = "all" Then
            Rec.SuiteCount = UBound(Registry) - LBound(Registry) + 1
            ReDim Rec.SuiteNames(0 To Rec.SuiteCount - 1)
            For I = 0 To Rec.SuiteCount - 1
                Rec.SuiteNames(I) = CStr(Registry(LBound(Registry) + I))
            Next I
        ElseIf IsRegisteredSuite(SuiteSelection) Then
            Rec.SuiteCount = 1
            ReDim Rec.SuiteNames(0 To 0)
            Rec.SuiteNames(0) = SuiteSelection
        Else
            Debug.Print "KPR test runner: refused; unknown suite: " & SuiteSelection
            Exit Function
        End If

    'Fail fast on an unusable output folder, before any suite runs
        If Not TryPrepareEvidencePath(OutputFolder, EvidencePath, Why) Then
            Debug.Print "KPR test runner: refused; " & Why
            Exit Function
        End If

'------------------------------------------------------------------------------
' INITIALIZE
'------------------------------------------------------------------------------
    'Per-suite results, NOT_RUN until each suite is recorded
        ReDim Rec.SuiteStatus(0 To Rec.SuiteCount - 1)
        ReDim Rec.SuiteChecks(0 To Rec.SuiteCount - 1)
        ReDim Rec.SuiteFails(0 To Rec.SuiteCount - 1)
        ReDim Rec.SuiteMs(0 To Rec.SuiteCount - 1)
        For I = 0 To Rec.SuiteCount - 1
            Rec.SuiteStatus(I) = "NOT_RUN"
        Next I
        Set Rec.Failures = New Collection
        Rec.SuiteSelection = SuiteSelection
        Rec.EntryPoint = EntryPoint
        Rec.SourceSha = SourceSha
        Rec.CallerType = CallerTypeName()

    'Keep whatever run this call interrupts, as KPR_Tests_RunAll does
        Set OuterFails = mFailures
        OuterChecks = mChecks
        OuterQuiet = mQuietTrace
        Current = -1

    'From here on every exit restores caller state
        On Error GoTo Run_Error
        CaptureCallerState State
        StateCaptured = True
        mQuietTrace = True
        Application.ScreenUpdating = False
        Application.EnableEvents = False
        Application.DisplayAlerts = False
        Application.Calculation = xlCalculationManual

'------------------------------------------------------------------------------
' RUN SUITES
'------------------------------------------------------------------------------
        Rec.StartedAt = Now
        StartTimer = Timer
        For I = 0 To Rec.SuiteCount - 1
            Current = I
            Harvested = False
            Application.StatusBar = "KPR test runner: " & Rec.SuiteNames(I) & _
                                    " (" & CStr(I + 1) & " of " & CStr(Rec.SuiteCount) & ")"
            Set mFailures = New Collection
            mChecks = 0
            SuiteTimer = Timer
            ExecuteSuite Rec.SuiteNames(I)
            HarvestSuite Rec, I, ElapsedMs(SuiteTimer), ""
            Harvested = True
        Next I
        GoTo Run_Restore

'------------------------------------------------------------------------------
' UNEXPECTED ERROR
'------------------------------------------------------------------------------
Run_Error:
    'Reaching here is a harness defect; record it against the suite it hit
        Rec.RunError = "unexpected runtime error " & CStr(Err.Number) & ": " & Err.Description
        If Current >= 0 And Not Harvested Then
            If mFailures Is Nothing Then Set mFailures = New Collection
            HarvestSuite Rec, Current, ElapsedMs(SuiteTimer), Rec.RunError
        Else
            Rec.Failures.Add Array("runner", "runner", Rec.RunError)
        End If
        Resume Run_Restore

'------------------------------------------------------------------------------
' RESTORE AND RECORD
'------------------------------------------------------------------------------
Run_Restore:
    On Error GoTo 0
    Rec.FinishedAt = Now
    Rec.TotalMs = ElapsedMs(StartTimer)
    mQuietTrace = OuterQuiet
    Set mFailures = OuterFails
    mChecks = OuterChecks

    'Restore, then verify, the caller's state
        If StateCaptured Then
            Rec.StateOk = RestoreCallerState(State, Rec.StateDetail)
        Else
            Rec.StateOk = False
            Rec.StateDetail = "caller state was not captured"
        End If

    'The run passes only when everything ran, passed and was restored
        Rec.Passed = (Len(Rec.RunError) = 0) And Rec.StateOk And (Rec.Failures.Count = 0)
        For I = 0 To Rec.SuiteCount - 1
            If Rec.SuiteStatus(I) <> "PASS" Then Rec.Passed = False
        Next I

    'Write the record; an unwritten record can never pass
        If Not TryWriteEvidence(EvidencePath, Rec, Why) Then
            Debug.Print "KPR test runner: evidence was not written; " & Why
            Exit Function
        End If

'------------------------------------------------------------------------------
' REPORT
'------------------------------------------------------------------------------
    Debug.Print "KPR test runner [" & SuiteSelection & "]  suites: " & CStr(Rec.SuiteCount) & _
                "  assertions: " & CStr(Rec.TotalChecks) & _
                "  failures: " & CStr(Rec.Failures.Count) & _
                "  state: " & IIf(Rec.StateOk, "PASS", "FAIL") & _
                "  RESULT=" & IIf(Rec.Passed, "PASS", "FAIL")
    For F = 1 To Rec.Failures.Count
        Entry = Rec.Failures.Item(F)
        Debug.Print "  FAIL  " & CStr(Entry(0)) & " / " & CStr(Entry(1)) & " : " & CStr(Entry(2))
    Next F
    If Not Rec.StateOk Then Debug.Print "  FAIL  state : " & Rec.StateDetail
    Debug.Print "  evidence: " & EvidencePath

    RunRegistry = Rec.Passed

End Function

Private Sub HarvestSuite( _
    ByRef Rec As RunRecord, _
    ByVal Index As Long, _
    ByVal Milliseconds As Long, _
    ByVal ExtraFailure As String)
'
' Copies the module state of the suite just run into the run record.
'

'------------------------------------------------------------------------------
' DECLARE
'------------------------------------------------------------------------------
    Dim F               As Long         'Failure cursor

'------------------------------------------------------------------------------
' RECORD
'------------------------------------------------------------------------------
    For F = 1 To mFailures.Count
        Rec.Failures.Add Array(Rec.SuiteNames(Index), CStr(mFailures(F)(0)), CStr(mFailures(F)(1)))
    Next F
    Rec.SuiteChecks(Index) = mChecks
    Rec.SuiteFails(Index) = mFailures.Count
    If Len(ExtraFailure) > 0 Then
        Rec.Failures.Add Array(Rec.SuiteNames(Index), Rec.SuiteNames(Index) & "/runner", ExtraFailure)
        Rec.SuiteFails(Index) = Rec.SuiteFails(Index) + 1
    ElseIf mChecks = 0 And mFailures.Count = 0 Then
        'A suite that asserted nothing proves nothing, so it cannot pass
        Rec.Failures.Add Array(Rec.SuiteNames(Index), Rec.SuiteNames(Index) & "/runner", _
                               "suite executed no assertions")
        Rec.SuiteFails(Index) = 1
    End If
    Rec.SuiteMs(Index) = Milliseconds
    Rec.TotalChecks = Rec.TotalChecks + mChecks
    If Rec.SuiteFails(Index) = 0 Then
        Rec.SuiteStatus(Index) = "PASS"
    Else
        Rec.SuiteStatus(Index) = "FAIL"
    End If

End Sub

Private Function IsRegisteredSuite( _
    ByVal SuiteName As String) _
    As Boolean
'
' TRUE when the name is in the durable registry.
'

'------------------------------------------------------------------------------
' DECLARE
'------------------------------------------------------------------------------
    Dim Registry        As Variant      'Ordered suite names
    Dim I               As Long         'Registry cursor

'------------------------------------------------------------------------------
' SEARCH
'------------------------------------------------------------------------------
    Registry = TestRegistry()
    For I = LBound(Registry) To UBound(Registry)
        If CStr(Registry(I)) = SuiteName Then
            IsRegisteredSuite = True
            Exit Function
        End If
    Next I

End Function

Private Function IsFullSha( _
    ByVal Sha As String) _
    As Boolean
'
' TRUE for exactly 40 lowercase hexadecimal characters.
'

'------------------------------------------------------------------------------
' DECLARE
'------------------------------------------------------------------------------
    Dim I               As Long         'Character cursor

'------------------------------------------------------------------------------
' CHECK
'------------------------------------------------------------------------------
    If Len(Sha) <> 40 Then Exit Function
    For I = 1 To 40
        If Not (Mid$(Sha, I, 1) Like "[0-9a-f]") Then Exit Function
    Next I
    IsFullSha = True

End Function

Private Function CallerTypeName() As String
'
' TypeName of Application.Caller, or "Unavailable" when it cannot be read.
' Direct VBA and Immediate-window calls report "Error".
'

'------------------------------------------------------------------------------
' READ
'------------------------------------------------------------------------------
    CallerTypeName = "Unavailable"
    On Error Resume Next
    CallerTypeName = TypeName(Application.Caller)
    Err.Clear

End Function

Private Function ElapsedMs( _
    ByVal StartTimer As Double) _
    As Long
'
' Milliseconds since StartTimer, allowing for one midnight rollover of Timer.
'

'------------------------------------------------------------------------------
' DECLARE
'------------------------------------------------------------------------------
    Dim Seconds         As Double       'Elapsed seconds

'------------------------------------------------------------------------------
' MEASURE
'------------------------------------------------------------------------------
    Seconds = Timer - StartTimer
    If Seconds < 0 Then Seconds = Seconds + 86400#
    ElapsedMs = CLng(Seconds * 1000#)

End Function

Private Function TryPrepareEvidencePath( _
    ByVal OutputFolder As String, _
    ByRef EvidencePath As String, _
    ByRef Why As String) _
    As Boolean
'
' Resolves the evidence file path, creating the folder and any missing parent
' folders, and proves the file can be written before any suite runs.
'

'------------------------------------------------------------------------------
' DECLARE
'------------------------------------------------------------------------------
    Dim Separator       As String       'Host path separator
    Dim FileNo          As Integer      'Probe file handle

'------------------------------------------------------------------------------
' NORMALIZE
'------------------------------------------------------------------------------
    Separator = Application.PathSeparator
    OutputFolder = Trim$(OutputFolder)
    If Len(OutputFolder) = 0 Then
        Why = "no output folder was supplied"
        Exit Function
    End If
    Do While Len(OutputFolder) > 1 And Right$(OutputFolder, 1) = Separator
        OutputFolder = Left$(OutputFolder, Len(OutputFolder) - 1)
    Loop

'------------------------------------------------------------------------------
' FOLDER
'------------------------------------------------------------------------------
    If Not TryCreateFolderTree(OutputFolder, Why) Then Exit Function

'------------------------------------------------------------------------------
' WRITE PROBE
'------------------------------------------------------------------------------
    On Error Resume Next
    EvidencePath = OutputFolder & Separator & EVIDENCE_FILE
    FileNo = FreeFile
    Open EvidencePath For Output As #FileNo
    If Err.Number <> 0 Then
        Why = "cannot write " & EvidencePath & " (error " & CStr(Err.Number) & ")"
        Err.Clear
        Exit Function
    End If
    Close #FileNo
    On Error GoTo 0
    TryPrepareEvidencePath = True

End Function

Private Function TryCreateFolderTree( _
    ByVal Folder As String, _
    ByRef Why As String) _
    As Boolean
'
' Creates Folder and every missing parent, one level at a time, because MkDir
' creates only a single level. A drive root and a UNC \\server\share root
' must already exist.
'

'------------------------------------------------------------------------------
' DECLARE
'------------------------------------------------------------------------------
    Dim Separator       As String       'Host path separator
    Dim Cursor          As Long         'Separator ending the current prefix
    Dim NextSep         As Long         'Next separator after Cursor
    Dim Part            As String       'Folder prefix being ensured
    Dim Attributes      As Long         'Attributes of Part

'------------------------------------------------------------------------------
' SKIP A UNC ROOT
'------------------------------------------------------------------------------
    Separator = Application.PathSeparator
    Cursor = 1
    If Left$(Folder, 2) = Separator & Separator Then
        Cursor = InStr(3, Folder, Separator)
        If Cursor > 0 Then Cursor = InStr(Cursor + 1, Folder, Separator)
        If Cursor = 0 Then Cursor = Len(Folder)
    End If

'------------------------------------------------------------------------------
' ENSURE EACH LEVEL
'------------------------------------------------------------------------------
    On Error Resume Next
    Do
        NextSep = InStr(Cursor + 1, Folder, Separator)
        If NextSep = 0 Then Part = Folder Else Part = Left$(Folder, NextSep - 1)
        If Len(Part) > 0 And Right$(Part, 1) <> ":" Then
            Err.Clear
            Attributes = GetAttr(Part)
            If Err.Number <> 0 Then
                Err.Clear
                MkDir Part
                If Err.Number <> 0 Then
                    Why = "cannot create folder " & Part & " (error " & CStr(Err.Number) & ")"
                    Err.Clear
                    Exit Function
                End If
            ElseIf (Attributes And vbDirectory) = 0 Then
                Why = Part & " is not a folder"
                Exit Function
            End If
        End If
        If NextSep = 0 Then Exit Do
        Cursor = NextSep
    Loop
    On Error GoTo 0
    TryCreateFolderTree = True

End Function

Private Sub CaptureCallerState( _
    ByRef State As CallerState)
'
' Records the application and selection state the runner will restore.
'

'------------------------------------------------------------------------------
' CAPTURE
'------------------------------------------------------------------------------
    On Error Resume Next
    State.Calculation = Application.Calculation
    State.EnableEvents = Application.EnableEvents
    State.ScreenUpdating = Application.ScreenUpdating
    State.DisplayAlerts = Application.DisplayAlerts
    State.StatusBar = Application.StatusBar
    Set State.Book = ActiveWorkbook
    Set State.SheetObject = ActiveSheet
    Set State.SelectionObject = Selection
    If Not State.Book Is Nothing Then State.BookName = State.Book.FullName
    If Not State.SheetObject Is Nothing Then State.SheetName = State.SheetObject.Name
    If Not State.SelectionObject Is Nothing Then
        State.SelectionType = TypeName(State.SelectionObject)
        If State.SelectionType = "Range" Then
            State.SelectionAddress = State.SelectionObject.Address(External:=True)
        Else
            'A chart, shape or other object is identified by its name when it has one
            Err.Clear
            State.SelectionName = CStr(State.SelectionObject.Name)
            If Err.Number <> 0 Then State.SelectionName = ""
        End If
    End If
    Err.Clear

End Sub

Private Function RestoreCallerState( _
    ByRef State As CallerState, _
    ByRef Detail As String) _
    As Boolean
'
' Restores the captured state, then reads every item back. Activation runs
' first, while events are still suppressed, so restoring the caller's
' workbook cannot fire the caller's own event handlers. A failed activation or
' selection is itself a restoration failure, not only a failed read-back.
'

'------------------------------------------------------------------------------
' DECLARE
'------------------------------------------------------------------------------
    Dim Problems        As String       'Items that did not restore
    Dim CurrentType     As String       'TypeName of the restored selection

'------------------------------------------------------------------------------
' RESTORE
'------------------------------------------------------------------------------
    On Error Resume Next
    If Not State.Book Is Nothing Then
        Err.Clear
        State.Book.Activate
        If Err.Number <> 0 Then Problems = Problems & "; active workbook (error " & CStr(Err.Number) & ")"
    End If
    If Not State.SheetObject Is Nothing Then
        Err.Clear
        State.SheetObject.Activate
        If Err.Number <> 0 Then Problems = Problems & "; active sheet (error " & CStr(Err.Number) & ")"
    End If
    If Not State.SelectionObject Is Nothing Then
        Err.Clear
        State.SelectionObject.Select
        If Err.Number <> 0 Then Problems = Problems & "; selection (error " & CStr(Err.Number) & ")"
    End If
    Err.Clear
    Application.StatusBar = State.StatusBar
    Application.DisplayAlerts = State.DisplayAlerts
    Application.ScreenUpdating = State.ScreenUpdating
    Application.Calculation = State.Calculation
    Application.EnableEvents = State.EnableEvents
    Err.Clear

'------------------------------------------------------------------------------
' VERIFY
'------------------------------------------------------------------------------
    If Application.Calculation <> State.Calculation Then Problems = Problems & "; calculation"
    If Application.EnableEvents <> State.EnableEvents Then Problems = Problems & "; events"
    If Application.ScreenUpdating <> State.ScreenUpdating Then Problems = Problems & "; screen updating"
    If Application.DisplayAlerts <> State.DisplayAlerts Then Problems = Problems & "; alerts"
    If VarType(State.StatusBar) = vbBoolean Then
        If VarType(Application.StatusBar) <> vbBoolean Then Problems = Problems & "; status bar"
    ElseIf CStr(Application.StatusBar) <> CStr(State.StatusBar) Then
        Problems = Problems & "; status bar"
    End If
    If Len(State.BookName) > 0 Then
        If ActiveWorkbook Is Nothing Then
            Problems = Problems & "; active workbook"
        ElseIf ActiveWorkbook.FullName <> State.BookName Then
            Problems = Problems & "; active workbook"
        End If
    End If
    If Len(State.SheetName) > 0 Then
        If ActiveSheet Is Nothing Then
            Problems = Problems & "; active sheet"
        ElseIf ActiveSheet.Name <> State.SheetName Then
            Problems = Problems & "; active sheet"
        End If
    End If
    If Len(State.SelectionType) > 0 Then
        CurrentType = TypeName(Selection)
        If CurrentType <> State.SelectionType Then
            Problems = Problems & "; selection type"
        ElseIf Len(State.SelectionAddress) > 0 Then
            If Selection.Address(External:=True) <> State.SelectionAddress Then
                Problems = Problems & "; selection"
            End If
        ElseIf Len(State.SelectionName) > 0 Then
            If CStr(Selection.Name) <> State.SelectionName Then Problems = Problems & "; selection"
        End If
    End If
    If Err.Number <> 0 Then
        Problems = Problems & "; verification error " & CStr(Err.Number)
        Err.Clear
    End If
    On Error GoTo 0

'------------------------------------------------------------------------------
' RESULT
'------------------------------------------------------------------------------
    If Len(Problems) = 0 Then
        Detail = "calculation, events, screen updating, alerts, status bar, active workbook, " & _
                 "active sheet and selection restored"
        RestoreCallerState = True
    Else
        Detail = "not restored: " & Mid$(Problems, 3)
    End If

End Function

'
'------------------------------------------------------------------------------
'
'                              EVIDENCE WRITER
'
'------------------------------------------------------------------------------
'

Private Function TryWriteEvidence( _
    ByVal EvidencePath As String, _
    ByRef Rec As RunRecord, _
    ByRef Why As String) _
    As Boolean
'
'==============================================================================
'                               TryWriteEvidence
'------------------------------------------------------------------------------
' PURPOSE
'   Writes the run record as JSON conforming to
'   docs/kpr-test-evidence.schema.json. Output is ASCII: every other
'   character is written as a JSON \u escape.
'
' DETERMINISM
'   Only the fields listed in nondeterministic_fields may differ between two
'   runs of the same source on the same host: /environment, /timing and each
'   suite's elapsed_ms.
'
' UPDATED
'   2026-09-25
'==============================================================================
'

'------------------------------------------------------------------------------
' DECLARE
'------------------------------------------------------------------------------
    Dim FileNo          As Integer      'Output file handle
    Dim Opened          As Boolean      'TRUE while FileNo is open
    Dim I               As Long         'Suite cursor
    Dim F               As Long         'Failure cursor
    Dim Sep             As String       'Array element separator
    Dim Regression      As String       'Regression outcome detail
    Dim Entry           As Variant      'One recorded failure: suite, case, detail

'------------------------------------------------------------------------------
' OPEN
'------------------------------------------------------------------------------
    On Error GoTo Write_Error
    FileNo = FreeFile
    Open EvidencePath For Output As #FileNo
    Opened = True

'------------------------------------------------------------------------------
' IDENTITY
'------------------------------------------------------------------------------
    Print #FileNo, "{"
    Print #FileNo, "  ""schema"": ""kpr-test-evidence"","
    Print #FileNo, "  ""schema_version"": 1,"
    Print #FileNo, "  ""source_sha"": " & JsonString(Rec.SourceSha) & ","
    Print #FileNo, "  ""runner"": {"
    Print #FileNo, "    ""module"": ""KPR_REGRESSION_TESTS"","
    Print #FileNo, "    ""entry_point"": " & JsonString(Rec.EntryPoint) & ","
    Print #FileNo, "    ""selection"": " & JsonString(Rec.SuiteSelection) & ","
    Print #FileNo, "    ""fixture_source_sha256"": " & JsonString(KPR_Fixtures_SourceHash()) & ","
    Print #FileNo, "    ""fixture_cases"": " & CStr(KPR_Fixtures_Count())
    Print #FileNo, "  },"

'------------------------------------------------------------------------------
' ENVIRONMENT AND TIMING
'------------------------------------------------------------------------------
    Print #FileNo, "  ""environment"": {"
    Print #FileNo, "    ""excel_version"": " & JsonString(CStr(Application.Version)) & ","
    Print #FileNo, "    ""excel_build"": " & JsonString(CStr(Application.Build)) & ","
    Print #FileNo, "    ""office_bitness"": " & JsonString(OfficeBitness()) & ","
    Print #FileNo, "    ""vba_version"": " & JsonString(VbaVersion()) & ","
    Print #FileNo, "    ""operating_system"": " & JsonString(CStr(Application.OperatingSystem)) & ","
    Print #FileNo, "    ""locale"": {"
    Print #FileNo, "      ""country_code"": " & CStr(CLng(Application.International(xlCountryCode))) & ","
    Print #FileNo, "      ""country_setting"": " & CStr(CLng(Application.International(xlCountrySetting))) & ","
    Print #FileNo, "      ""decimal_separator"": " & JsonString(CStr(Application.International(xlDecimalSeparator))) & ","
    Print #FileNo, "      ""list_separator"": " & JsonString(CStr(Application.International(xlListSeparator))) & ","
    Print #FileNo, "      ""date_order"": " & JsonString(DateOrderName(CLng(Application.International(xlDateOrder))))
    Print #FileNo, "    },"
    Print #FileNo, "    ""workbook_date_system"": " & IIf(ThisWorkbook.Date1904, "1904", "1900") & ","
    Print #FileNo, "    ""caller"": {"
    Print #FileNo, "      ""application_caller_type"": " & JsonString(Rec.CallerType) & ","
    Print #FileNo, "      ""direct_suites"": ""direct-vba-1900"","
    Print #FileNo, "      ""worksheet_suites"": ""scratch-workbook-range"""
    Print #FileNo, "    }"
    Print #FileNo, "  },"
    Print #FileNo, "  ""timing"": {"
    Print #FileNo, "    ""started_local"": " & JsonString(IsoTimestamp(Rec.StartedAt)) & ","
    Print #FileNo, "    ""finished_local"": " & JsonString(IsoTimestamp(Rec.FinishedAt)) & ","
    Print #FileNo, "    ""elapsed_ms"": " & CStr(Rec.TotalMs)
    Print #FileNo, "  },"
    Print #FileNo, "  ""nondeterministic_fields"": [""/environment"", ""/timing"", ""/suites/*/elapsed_ms""],"

'------------------------------------------------------------------------------
' SUITES AND FAILURES
'------------------------------------------------------------------------------
    Print #FileNo, "  ""suites"": ["
    For I = 0 To Rec.SuiteCount - 1
        If I < Rec.SuiteCount - 1 Then Sep = "," Else Sep = ""
        Print #FileNo, "    {""name"": " & JsonString(Rec.SuiteNames(I)) & _
                       ", ""kind"": " & JsonString(SuiteKind(Rec.SuiteNames(I))) & _
                       ", ""status"": " & JsonString(Rec.SuiteStatus(I)) & _
                       ", ""assertions"": " & CStr(Rec.SuiteChecks(I)) & _
                       ", ""failures"": " & CStr(Rec.SuiteFails(I)) & _
                       ", ""elapsed_ms"": " & CStr(Rec.SuiteMs(I)) & "}" & Sep
    Next I
    Print #FileNo, "  ],"
    Print #FileNo, "  ""failures"": ["
    For F = 1 To Rec.Failures.Count
        If F < Rec.Failures.Count Then Sep = "," Else Sep = ""
        Entry = Rec.Failures.Item(F)
        Print #FileNo, "    {""suite"": " & JsonString(CStr(Entry(0))) & _
                       ", ""case"": " & JsonString(CStr(Entry(1))) & _
                       ", ""detail"": " & JsonString(CStr(Entry(2))) & "}" & Sep
    Next F
    Print #FileNo, "  ],"
    Print #FileNo, "  ""totals"": {""suites"": " & CStr(Rec.SuiteCount) & _
                   ", ""assertions"": " & CStr(Rec.TotalChecks) & _
                   ", ""failures"": " & CStr(Rec.Failures.Count) & "},"
    Print #FileNo, "  ""state_restoration"": {""status"": " & IIf(Rec.StateOk, """PASS""", """FAIL""") & _
                   ", ""detail"": " & JsonString(Rec.StateDetail) & "},"

'------------------------------------------------------------------------------
' CERTIFICATION OUTCOMES
'------------------------------------------------------------------------------
    Regression = CStr(Rec.SuiteCount) & " suite(s), " & CStr(Rec.TotalChecks) & _
                 " assertion(s), " & CStr(Rec.Failures.Count) & " failure(s)"
    If Len(Rec.RunError) > 0 Then Regression = Regression & "; " & Rec.RunError
    Print #FileNo, "  ""certification"": {"
    Print #FileNo, "    ""source_import"": " & OperatorOutcome() & ","
    Print #FileNo, "    ""vba_compile"": " & OperatorOutcome() & ","
    If Rec.Passed Then
        Print #FileNo, "    ""regression"": " & JsonOutcome("PASS", Regression, "") & ","
    Else
        Print #FileNo, "    ""regression"": " & JsonOutcome("FAIL", Regression, "") & ","
    End If
    Print #FileNo, "    ""cross_oracle"": " & _
                   JsonOutcome("NOT_RUN", "", "No cross-oracle suite is registered in this candidate (#41).") & ","
    Print #FileNo, "    ""macro_options"": " & OperatorOutcome() & ","
    Print #FileNo, "    ""ribbonx"": " & OperatorOutcome() & ","
    Print #FileNo, "    ""commandbars"": " & OperatorOutcome() & ","
    Print #FileNo, "    ""demo_generation"": " & OperatorOutcome() & ","
    Print #FileNo, "    ""source_round_trip"": " & OperatorOutcome()
    Print #FileNo, "  },"
    Print #FileNo, "  ""result"": " & IIf(Rec.Passed, """PASS""", """FAIL""")
    Print #FileNo, "}"

'------------------------------------------------------------------------------
' CLOSE
'------------------------------------------------------------------------------
    Close #FileNo
    Opened = False
    TryWriteEvidence = True
    Exit Function

Write_Error:
    Why = "error " & CStr(Err.Number) & ": " & Err.Description
    Err.Clear
    On Error Resume Next
    If Opened Then Close #FileNo
    Err.Clear

End Function

Private Function OperatorOutcome() As String
'
' An outcome the runner cannot observe; the certification operator records it.
'
    OperatorOutcome = JsonOutcome("NOT_RUN", "", _
                                  "Outside the regression runner; the certification operator records this outcome.")

End Function

Private Function JsonOutcome( _
    ByVal Status As String, _
    ByVal Detail As String, _
    ByVal Reason As String) _
    As String
'
' One certification outcome object. Empty detail or reason is JSON null.
'

'------------------------------------------------------------------------------
' DECLARE
'------------------------------------------------------------------------------
    Dim DetailJson      As String       'Detail as JSON
    Dim ReasonJson      As String       'Reason as JSON

'------------------------------------------------------------------------------
' BUILD
'------------------------------------------------------------------------------
    If Len(Detail) = 0 Then DetailJson = "null" Else DetailJson = JsonString(Detail)
    If Len(Reason) = 0 Then ReasonJson = "null" Else ReasonJson = JsonString(Reason)
    JsonOutcome = "{""status"": " & JsonString(Status) & _
                  ", ""detail"": " & DetailJson & _
                  ", ""reason"": " & ReasonJson & "}"

End Function

Private Function JsonString( _
    ByVal S As String) _
    As String
'
' Quotes and escapes a string as ASCII-only JSON.
'

'------------------------------------------------------------------------------
' DECLARE
'------------------------------------------------------------------------------
    Dim I               As Long         'Character cursor
    Dim Code            As Long         'UTF-16 code unit
    Dim Out             As String       'Escaped text

'------------------------------------------------------------------------------
' ESCAPE
'------------------------------------------------------------------------------
    For I = 1 To Len(S)
        Code = AscW(Mid$(S, I, 1))
        If Code < 0 Then Code = Code + 65536
        Select Case Code
            Case 34:            Out = Out & "\"""
            Case 92:            Out = Out & "\\"
            Case 8:             Out = Out & "\b"
            Case 9:             Out = Out & "\t"
            Case 10:            Out = Out & "\n"
            Case 12:            Out = Out & "\f"
            Case 13:            Out = Out & "\r"
            Case 32 To 126:     Out = Out & ChrW$(Code)
            Case Else:          Out = Out & "\u" & Right$("000" & LCase$(Hex$(Code)), 4)
        End Select
    Next I
    JsonString = """" & Out & """"

End Function

Private Function IsoTimestamp( _
    ByVal Stamp As Date) _
    As String
'
' Local wall-clock time as yyyy-mm-ddThh:nn:ss, independent of the host's
' date and time separators.
'
    IsoTimestamp = IsoDate(Stamp) & "T" & _
                   Right$("0" & CStr(Hour(Stamp)), 2) & ":" & _
                   Right$("0" & CStr(Minute(Stamp)), 2) & ":" & _
                   Right$("0" & CStr(Second(Stamp)), 2)

End Function

Private Function IsoDate( _
    ByVal Stamp As Date) _
    As String
'
' yyyy-mm-dd, independent of the host's date separator.
'
    IsoDate = Right$("000" & CStr(Year(Stamp)), 4) & "-" & _
              Right$("0" & CStr(Month(Stamp)), 2) & "-" & _
              Right$("0" & CStr(Day(Stamp)), 2)

End Function

