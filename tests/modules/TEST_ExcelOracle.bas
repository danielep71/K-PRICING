            "EOMONTH(DATE(9999,2,1),0)-MOD(WEEKDAY(EOMONTH(DATE(9999,2,1),0),2)-5,7)"), "date")
        TEST_Harness.AssertEqualText "matrix-lastweekdayofmonth-yearin-edge-high", _
            "date:9999-02-26", Actual
    'Regression case (surface): locator/last Sunday.
        Actual = TEST_WorksheetSupport.EncodeCell(Sheet.Evaluate( _
            "EOMONTH(DATE(2026,3,1),0)-MOD(WEEKDAY(EOMONTH(DATE(2026,3,1),0),2)-7,7)"), "date")
        TEST_Harness.AssertEqualText "regression-surface-locator-last-sunday", "date:2026-03-29", _
            Actual
    'Supported surface, ISO text inputs.
        Actual = TEST_WorksheetSupport.EncodeCell(Sheet.Evaluate( _
            "EOMONTH(DATE(2024,2,1),0)-MOD(WEEKDAY(EOMONTH(DATE(2024,2,1),0),2)-5,7)"), "date")
        TEST_Harness.AssertEqualText "surface-lastweekdayofmonth-ok", "date:2024-02-23", Actual

'------------------------------------------------------------------------------
' EXIT PROCEDURE
'------------------------------------------------------------------------------
CleanUp:
    'Restore normal error handling
        On Error GoTo 0
    'Close the scratch workbook and restore the calculation mode
        Detail = TEST_WorksheetSupport.CloseScratch()
        TEST_Harness.AssertTrue "scratch-closed", Len(Detail) = 0, Detail
    'Record the case's error, once Excel is restored
        If ErrNumber <> 0 Then
            Err.Number = ErrNumber
            Err.Source = ErrSource
            Err.Description = ErrDescription
            TEST_Harness.RecordCaseError
        End If
    'Exit before the error handlers
        Exit Sub

'------------------------------------------------------------------------------
' ERROR HANDLER
'------------------------------------------------------------------------------
Failed:
    'Keep the case's error and close the workbook
        ErrNumber = Err.Number
        ErrSource = Err.Source
        ErrDescription = Err.Description
        Resume CleanUp

CaseFailed:
    'Record the unexpected error against the case
        TEST_Harness.RecordCaseError

End Sub
