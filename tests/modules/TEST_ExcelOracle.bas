Private Sub CaseDayOfWeek01()

'
'------------------------------------------------------------------------------
'                             ORACLE OF DAYOFWEEK
'------------------------------------------------------------------------------
' PURPOSE
'   Computes 30 cases of DayOfWeek with Excel's worksheet functions, from control-weekbase-empty
'   to weekday-sunday-base-1900-03-31.
'
' WHY THIS EXISTS
'   Each assertion compares Excel's result with the case's expected file, which the date
'   layer's code never computed.
'
' INPUTS
'   None
'
' RETURNS
'   Nothing
'
' BEHAVIOR
'   Opens a scratch workbook in the 1900 date system, evaluates each case's formula on its
'   sheet, and asserts the encoded value under the case's id. Closes the workbook on every
'   path and asserts that it did.
'
' ERROR POLICY
'   An unexpected error is kept, the workbook closed, and the error recorded against
'   the case by TEST_Harness.RecordCaseError; it does not stop the run
'
' DEPENDENCIES
'   TEST_WorksheetSupport, TEST_Harness; Excel's worksheet functions
'
' NOTES
'   Generated by tools/gen_excel_oracle_suite.py from tests/fixtures/
'
' UPDATED
'   2026-11-26
'------------------------------------------------------------------------------

'------------------------------------------------------------------------------
' DECLARE
'------------------------------------------------------------------------------
    Const PROC_NAME     As String = "TEST_ExcelOracle.CaseDayOfWeek01"

    Dim Sheet           As Worksheet    'The scratch sheet
    Dim Actual          As String       'The encoded value of a formula
    Dim Detail          As String       'What closing the workbook could not restore
    Dim ErrNumber       As Long         'Error of the case; 0 for none
    Dim ErrSource       As String       'Its source
    Dim ErrDescription  As String       'Its description

'------------------------------------------------------------------------------
' INITIALIZE
'------------------------------------------------------------------------------
    'Record an unexpected error against the case
        On Error GoTo CaseFailed
    'Start the case
        TEST_Harness.BeginCase "day-of-week-01"
    'Close the scratch workbook on every path
        On Error GoTo Failed

'------------------------------------------------------------------------------
' RUN CASES
'------------------------------------------------------------------------------
    'Open a scratch workbook in the 1900 date system
        Set Sheet = TEST_WorksheetSupport.OpenScratch(False)
    'Opt_WeekBaseMonday accepts omitted, Empty or native Boolean only.
        Actual = TEST_WorksheetSupport.EncodeCell(Sheet.Evaluate("WEEKDAY(DATE(2024,2,11),2)"), _
            "lng")
        TEST_Harness.AssertEqualText "control-weekbase-empty", "lng:7", Actual
    'Opt_WeekBaseMonday accepts omitted, Empty or native Boolean only.
        Actual = TEST_WorksheetSupport.EncodeCell(Sheet.Evaluate("WEEKDAY(DATE(2024,2,11),1)"), _
            "lng")
        TEST_Harness.AssertEqualText "control-weekbase-false", "lng:1", Actual
    'Opt_WeekBaseMonday accepts omitted, Empty or native Boolean only.
        Actual = TEST_WorksheetSupport.EncodeCell(Sheet.Evaluate("WEEKDAY(DATE(2024,2,11),2)"), _
            "lng")
        TEST_Harness.AssertEqualText "control-weekbase-omitted", "lng:7", Actual
    'Opt_WeekBaseMonday accepts omitted, Empty or native Boolean only.
        Actual = TEST_WorksheetSupport.EncodeCell(Sheet.Evaluate("WEEKDAY(DATE(2024,2,11),2)"), _
            "lng")
        TEST_Harness.AssertEqualText "control-weekbase-true", "lng:7", Actual
    'DateIn: the highest supported value.
        Actual = TEST_WorksheetSupport.EncodeCell(Sheet.Evaluate("WEEKDAY(DATE(9999,12,31),2)"), _
            "lng")
        TEST_Harness.AssertEqualText "matrix-dayofweek-datein-edge-high", "lng:5", Actual
    'DateIn: the lowest supported value.
        Actual = TEST_WorksheetSupport.EncodeCell(Sheet.Evaluate("WEEKDAY(DATE(1900,3,1),2)"), _
            "lng")
        TEST_Harness.AssertEqualText "matrix-dayofweek-datein-edge-low", "lng:4", Actual
    'A valid scalar call.
        Actual = TEST_WorksheetSupport.EncodeCell(Sheet.Evaluate("WEEKDAY(DATE(2024,2,10),2)"), _
            "lng")
        TEST_Harness.AssertEqualText "matrix-dayofweek-ok", "lng:6", Actual
    'A valid 1900 worksheet call evaluates normally.
        Actual = TEST_WorksheetSupport.EncodeCell(Sheet.Evaluate("WEEKDAY(DATE(2024,2,10),2)"), _
            "lng")
        TEST_Harness.AssertEqualText "matrix-dayofweek-ws1900", "lng:6", Actual
    'Monday base, Monday is 1 and Sunday is 7.
        Actual = TEST_WorksheetSupport.EncodeCell(Sheet.Evaluate("WEEKDAY(DATE(1900,3,1),2)"), _
            "lng")
        TEST_Harness.AssertEqualText "weekday-monday-base-1900-03-01", "lng:4", Actual
    'Monday base, Monday is 1 and Sunday is 7.
        Actual = TEST_WorksheetSupport.EncodeCell(Sheet.Evaluate("WEEKDAY(DATE(1900,3,31),2)"), _
            "lng")
        TEST_Harness.AssertEqualText "weekday-monday-base-1900-03-31", "lng:6", Actual
    'Monday base, Monday is 1 and Sunday is 7.
        Actual = TEST_WorksheetSupport.EncodeCell(Sheet.Evaluate("WEEKDAY(DATE(1900,4,15),2)"), _
            "lng")
        TEST_Harness.AssertEqualText "weekday-monday-base-1900-04-15", "lng:7", Actual
    'Monday base, Monday is 1 and Sunday is 7.
        Actual = TEST_WorksheetSupport.EncodeCell(Sheet.Evaluate("WEEKDAY(DATE(1900,12,31),2)"), _
            "lng")
        TEST_Harness.AssertEqualText "weekday-monday-base-1900-12-31", "lng:1", Actual
    'Monday base, Monday is 1 and Sunday is 7.
        Actual = TEST_WorksheetSupport.EncodeCell(Sheet.Evaluate("WEEKDAY(DATE(1901,1,1),2)"), _
            "lng")
        TEST_Harness.AssertEqualText "weekday-monday-base-1901-01-01", "lng:2", Actual
    'Monday base, Monday is 1 and Sunday is 7.
        Actual = TEST_WorksheetSupport.EncodeCell(Sheet.Evaluate("WEEKDAY(DATE(1999,12,31),2)"), _
            "lng")
        TEST_Harness.AssertEqualText "weekday-monday-base-1999-12-31", "lng:5", Actual
    'Monday base, Monday is 1 and Sunday is 7.
        Actual = TEST_WorksheetSupport.EncodeCell(Sheet.Evaluate("WEEKDAY(DATE(2000,2,29),2)"), _
            "lng")
        TEST_Harness.AssertEqualText "weekday-monday-base-2000-02-29", "lng:2", Actual
    'Monday base, Monday is 1 and Sunday is 7.
        Actual = TEST_WorksheetSupport.EncodeCell(Sheet.Evaluate("WEEKDAY(DATE(2000,3,31),2)"), _
            "lng")
        TEST_Harness.AssertEqualText "weekday-monday-base-2000-03-31", "lng:5", Actual
    'Monday base, Monday is 1 and Sunday is 7.
        Actual = TEST_WorksheetSupport.EncodeCell(Sheet.Evaluate("WEEKDAY(DATE(2023,2,28),2)"), _
            "lng")
        TEST_Harness.AssertEqualText "weekday-monday-base-2023-02-28", "lng:2", Actual
    'Monday base, Monday is 1 and Sunday is 7.
        Actual = TEST_WorksheetSupport.EncodeCell(Sheet.Evaluate("WEEKDAY(DATE(2024,2,28),2)"), _
            "lng")
        TEST_Harness.AssertEqualText "weekday-monday-base-2024-02-28", "lng:3", Actual
    'Monday base, Monday is 1 and Sunday is 7.
        Actual = TEST_WorksheetSupport.EncodeCell(Sheet.Evaluate("WEEKDAY(DATE(2024,2,29),2)"), _
            "lng")
        TEST_Harness.AssertEqualText "weekday-monday-base-2024-02-29", "lng:4", Actual
    'Monday base, Monday is 1 and Sunday is 7.
        Actual = TEST_WorksheetSupport.EncodeCell(Sheet.Evaluate("WEEKDAY(DATE(2024,3,31),2)"), _
            "lng")
        TEST_Harness.AssertEqualText "weekday-monday-base-2024-03-31", "lng:7", Actual
    'Monday base, Monday is 1 and Sunday is 7.
        Actual = TEST_WorksheetSupport.EncodeCell(Sheet.Evaluate("WEEKDAY(DATE(2024,6,30),2)"), _
            "lng")
        TEST_Harness.AssertEqualText "weekday-monday-base-2024-06-30", "lng:7", Actual
    'Monday base, Monday is 1 and Sunday is 7.
        Actual = TEST_WorksheetSupport.EncodeCell(Sheet.Evaluate("WEEKDAY(DATE(2024,7,1),2)"), _
            "lng")
        TEST_Harness.AssertEqualText "weekday-monday-base-2024-07-01", "lng:1", Actual
    'Monday base, Monday is 1 and Sunday is 7.
        Actual = TEST_WorksheetSupport.EncodeCell(Sheet.Evaluate("WEEKDAY(DATE(2024,9,30),2)"), _
            "lng")
        TEST_Harness.AssertEqualText "weekday-monday-base-2024-09-30", "lng:1", Actual
    'Monday base, Monday is 1 and Sunday is 7.
        Actual = TEST_WorksheetSupport.EncodeCell(Sheet.Evaluate("WEEKDAY(DATE(2024,11,30),2)"), _
            "lng")
        TEST_Harness.AssertEqualText "weekday-monday-base-2024-11-30", "lng:6", Actual
    'Monday base, Monday is 1 and Sunday is 7.
