        Actual = TEST_WorksheetSupport.EncodeCell(Sheet.Evaluate("WEEKDAY(DATE(2100,2,28),2)"), _
            "lng")
        TEST_Harness.AssertEqualText "weekday-monday-base-2100-02-28", "lng:7", Actual
    'Monday base, Monday is 1 and Sunday is 7.
        Actual = TEST_WorksheetSupport.EncodeCell(Sheet.Evaluate("WEEKDAY(DATE(9999,1,1),2)"), _
            "lng")
        TEST_Harness.AssertEqualText "weekday-monday-base-9999-01-01", "lng:5", Actual
    'Monday base, Monday is 1 and Sunday is 7.
        Actual = TEST_WorksheetSupport.EncodeCell(Sheet.Evaluate("WEEKDAY(DATE(9999,12,31),2)"), _
            "lng")
        TEST_Harness.AssertEqualText "weekday-monday-base-9999-12-31", "lng:5", Actual
    'Sunday base, Sunday is 1 and Saturday is 7.
        Actual = TEST_WorksheetSupport.EncodeCell(Sheet.Evaluate("WEEKDAY(DATE(1900,3,1),1)"), _
            "lng")
        TEST_Harness.AssertEqualText "weekday-sunday-base-1900-03-01", "lng:5", Actual
    'Sunday base, Sunday is 1 and Saturday is 7.
        Actual = TEST_WorksheetSupport.EncodeCell(Sheet.Evaluate("WEEKDAY(DATE(1900,3,31),1)"), _
            "lng")
        TEST_Harness.AssertEqualText "weekday-sunday-base-1900-03-31", "lng:7", Actual

'------------------------------------------------------------------------------
' EXIT PROCEDURE
'------------------------------------------------------------------------------
CleanUp:
    'Restore normal error handling
        On Error GoTo 0
    'Close the scratch workbook and restore the calculation mode
        Detail = TEST_WorksheetSupport.CloseScratch()
        TEST_Harness.AssertTrue "scratch-closed", Len(Detail) = 0, Detail
    'Record the case's error, once Excel is restored
        If ErrNumber <> 0 Then
            Err.Number = ErrNumber
            Err.Source = ErrSource
            Err.Description = ErrDescription
            TEST_Harness.RecordCaseError
        End If
    'Exit before the error handlers
        Exit Sub

'------------------------------------------------------------------------------
' ERROR HANDLER
'------------------------------------------------------------------------------
Failed:
    'Keep the case's error and close the workbook
        ErrNumber = Err.Number
        ErrSource = Err.Source
        ErrDescription = Err.Description
        Resume CleanUp

CaseFailed:
    'Record the unexpected error against the case
        TEST_Harness.RecordCaseError

End Sub

