Attribute VB_Name = "TEST_ExcelOracle"

Option Explicit
Option Private Module

'
'------------------------------------------------------------------------------
' MODULE: TEST_ExcelOracle
'------------------------------------------------------------------------------
' PURPOSE
'   The Excel oracle of the date layer: the worksheet-function cases that Excel's own functions
'   can compute, computed with them and compared, as encoded text, with their expected files
'
' WHY THIS EXISTS
'   A second computation by another author catches an error that the derivation of the
'   expected values and the date layer's code could share
'
' INPUTS
'   None at module level
'
' RETURNS
'   Nothing at module level
'
' BEHAVIOR
'   RunExcelOracleTests runs the suite: 21 cases of up to 30 test cases of one function,
'   437 assertions: one per covered test case, named after it, and scratch-closed per case.
'   1219 test cases are excluded, each for a stated reason (docs/methodology/
'   EXCEL_ORACLE.md). CertifyExcelOracle certifies its normal run and saves its log and its
'   certification log
'
' ERROR POLICY
'   As TEST_Harness.EndRun: a run that does not pass raises TEST_Harness.ERR_TEST_FAILED,
'   or the unexpected error that escaped the runner
'
' DEPENDENCIES
'   TEST_WorksheetSupport, TEST_Harness; Excel's worksheet functions DATE, YEAR, MONTH, DAY,
'   EOMONTH, EDATE, WEEKDAY, INT, MOD, IF
'
' NOTES
'   - GENERATED by tools/gen_excel_oracle_suite.py from tests/fixtures/ and tests/expected/:
'     never edit it by hand; regenerate it with --write
'   - It calls no procedure of the date layer: each result comes from Worksheet.Evaluate
'   - Option Private Module keeps the suite out of the workbook's external surface
'
' UPDATED
'   2026-11-26
'------------------------------------------------------------------------------

'------------------------------------------------------------------------------
' PRIVATE CONSTANTS
'------------------------------------------------------------------------------
    'A complete run starts every case and evaluates every assertion once
    Private Const SUITE_NAME            As String = "excel-oracle"      'Suite name in the run log
    Private Const EXPECTED_CASES        As Long = 21                    'Cases a complete run starts
    Private Const EXPECTED_ASSERTIONS   As Long = 437                   'Assertions a complete run evaluates


'
'------------------------------------------------------------------------------
'
'                                 ENTRY POINTS
'
'------------------------------------------------------------------------------
'

Public Sub RunExcelOracleTests()

'
'------------------------------------------------------------------------------
'                                RUN THE SUITE
'------------------------------------------------------------------------------
' PURPOSE
'   Runs every case of the suite once, in its normal mode.
'
' WHY THIS EXISTS
'   The entry point to type in the Immediate window.
'
' INPUTS
'   None
'
' RETURNS
'   Nothing
'
' BEHAVIOR
'   Runs RunSuite.
'
' ERROR POLICY
'   As RunSuite
'
' DEPENDENCIES
'   RunSuite
'
' NOTES
'   None
'
' UPDATED
'   2026-11-26
'------------------------------------------------------------------------------

'------------------------------------------------------------------------------
' RUN
'------------------------------------------------------------------------------
    'Run the suite
        RunSuite

End Sub

Public Sub CertifyExcelOracle( _
    ByVal Folder As String, _
    ByVal Fixtures As String)
'
'------------------------------------------------------------------------------
'                              CERTIFY THE SUITE
'------------------------------------------------------------------------------
' PURPOSE
'   Certifies the suite's normal run and saves its evidence in the folder.
'
' WHY THIS EXISTS
'   The certification entry point that .github/excel-evidence-policy.json names.
'
' INPUTS
'   Folder
'     The evidence folder.
'
'   Fixtures
'     The tests/fixtures/ folder, which this generated suite does not read.
'
' RETURNS
'   Nothing
'
' BEHAVIOR
'   Runs the suite, saves its log, certifies the run, then saves the certification log.
'
' ERROR POLICY
'   TEST_Harness.EndCertification raises when the certification did not pass.
'
' DEPENDENCIES
'   RunSuite, TEST_Harness
'
' NOTES
'   None
'
' UPDATED
'   2026-11-26
'------------------------------------------------------------------------------

'------------------------------------------------------------------------------
' DECLARE
'------------------------------------------------------------------------------
    Const PROC_NAME     As String = "TEST_ExcelOracle.CertifyExcelOracle"

    Dim RunErrorNumber          As Long     'Error that ended the run; 0 for none
    Dim RunErrorDescription     As String   'Its description

'------------------------------------------------------------------------------
' CERTIFY
'------------------------------------------------------------------------------
    'Refuse state left by an earlier run and start the certification
        TEST_Harness.BeginCertification SUITE_NAME
    'Run the suite and capture the error that ended it
        On Error Resume Next
        RunSuite
        RunErrorNumber = Err.Number
        RunErrorDescription = Err.Description
    'Restore normal error handling
        On Error GoTo 0
    'Save the log and certify the run
        TEST_Harness.SaveLog Folder & "\excel-oracle.log"
        TEST_Harness.CertifyRun "NORMAL", True, RunErrorNumber, RunErrorDescription
    'Save the certification log, raising when the certification did not pass
        TEST_Harness.EndCertification Folder & "\excel-oracle-certification.log"

End Sub

'
'------------------------------------------------------------------------------
'
'                                    RUNNER
'
'------------------------------------------------------------------------------
'

Private Sub RunSuite()

'
'------------------------------------------------------------------------------
'                                RUN EVERY CASE
'------------------------------------------------------------------------------
' PURPOSE
'   Runs every case once, in a fixed order, between BeginRun and EndRun.
'
' WHY THIS EXISTS
'   The certification reads the cases this runner calls.
'
' INPUTS
'   None
'
' RETURNS
'   Nothing
'
' BEHAVIOR
'   Starts the run, calls each case, then reports the run.
'
' ERROR POLICY
'   As TEST_Harness.EndRun
'
' DEPENDENCIES
'   TEST_Harness
'
' NOTES
'   None
'
' UPDATED
'   2026-11-26
'------------------------------------------------------------------------------

'------------------------------------------------------------------------------
' DECLARE
'------------------------------------------------------------------------------
    Const PROC_NAME     As String = "TEST_ExcelOracle.RunSuite"

    Dim ErrNumber       As Long     'Runner error number; 0 for none
    Dim ErrSource       As String   'Runner error source
    Dim ErrDescription  As String   'Runner error description

'------------------------------------------------------------------------------
' INITIALIZE
'------------------------------------------------------------------------------
    'Start the run; a refused start propagates directly
        TEST_Harness.BeginRun SUITE_NAME, "NORMAL", EXPECTED_CASES, EXPECTED_ASSERTIONS
    'Send an error that escapes a case to the runner handler
        On Error GoTo RunFailed

'------------------------------------------------------------------------------
' RUN CASES
'------------------------------------------------------------------------------
    'Run every case in a fixed order
        CaseDayOfWeek01
        CaseDayOfWeek02
        CaseDaysInMonth01
        CaseDaysInYear01
        CaseBeginOfMonth01
        CaseEndOfMonth01
        CaseEndOfMonth02
        CaseBeginOfQuarter01
        CaseEndOfQuarter01
        CaseBeginOfYear01
        CaseEndOfYear01
        CaseIsMonthEnd01
        CaseIsQuarterEnd01
        CaseIsYearEnd01
        CaseIsLeapYear01
        CaseAddDays01
        CaseAddWeeks01
        CaseAddMonths01
        CaseAddYears01
        CaseNthWeekdayOfMonth01
        CaseLastWeekdayOfMonth01

Finish:
    'Restore normal error handling
        On Error GoTo 0
    'Report the run, raising its failure or the escaped error
        TEST_Harness.EndRun ErrNumber, ErrSource, ErrDescription

'------------------------------------------------------------------------------
' EXIT PROCEDURE
'------------------------------------------------------------------------------
    'Exit before the error handler
        Exit Sub

'------------------------------------------------------------------------------
' ERROR HANDLER
'------------------------------------------------------------------------------
RunFailed:
    'Keep the escaped error for EndRun
        ErrNumber = Err.Number
        ErrSource = Err.Source
        ErrDescription = Err.Description
        Resume Finish

End Sub

